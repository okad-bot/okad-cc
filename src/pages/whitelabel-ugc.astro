        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Key terms</h2>

        {[
          { term: "Whitelabel UGC", def: "Creator-produced video content delivered as raw files to the brand. The creator films and the brand controls all distribution. The simplest UGC production model." },
          { term: "Raw files", def: "The original video files delivered by the creator — MP4 format, no platform compression. The brand receives clean source material for editing." },
          { term: "Remix / variant", def: "Creating multiple ad versions from a single raw video by swapping hooks, captions, CTAs, or trimming to different lengths. One video becomes 2-3 testable variants." },
          { term: "Creative fatigue", def: "When an ad's performance declines because the target audience has seen it too many times. Typically occurs after 2-4 weeks of running at scale." },
          { term: "Hook", def: "The first 1-3 seconds of the video, designed to stop the scroll. Hooks are the single biggest lever in ad performance. Test multiple hooks per body." },
          { term: "Modular content", def: "Briefing creators to deliver the main video plus 2-3 separate alternate hook openings, allowing the brand to assemble multiple variants without re-shoots." },
          { term: "Winner rate", def: "The percentage of tested ad variants that beat the target CPA. Typical whitelabel UGC winner rate: 10-20%." },
          { term: "Creative testing", def: "The systematic process of testing multiple ad creative variants to find winners. Whitelabel UGC is the production engine that feeds creative testing." },
          { term: "Canvas UGC", def: "A different model: creators post on brand-owned social accounts and are paid per view. Distinct from whitelabel, where creators deliver files." },
          { term: "Whitelisting", def: "A different model: brand runs paid ads from the creator's personal account. Distinct from whitelabel, where ads run from the brand's account." },
        ].map((item) => (
