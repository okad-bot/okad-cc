---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const emailSubject = "mailto:olga@okad.agency?subject=Whitelabel%20UGC%20production%20%E2%80%94%20tell%20us%20about%20your%20brand";
const calHref = "https://calendly.com/okad_calls/first";
---

<Layout
  title="Whitelabel UGC — The Complete Guide to Raw Creator Video for Ads | OKAD"
  description="Whitelabel UGC is creator-produced video delivered as raw files for the brand to use as paid ad creative. $150-$500 per video. Brand owns distribution, creator provides the content. Full guide."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="pt-20 md:pt-24 pb-10 text-center bg-bg">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="inline-flex items-center gap-1.5 text-[12px] font-medium text-accent bg-[rgba(99,102,241,.06)] border border-[rgba(99,102,241,.18)] rounded-full px-3.5 py-1.5 mb-6">
          Open reference &middot; September 2026
        </div>
        <h1 class="font-display font-bold text-[clamp(28px,5vw,48px)] leading-[1.1] tracking-[-0.03em] text-ink mb-4">
          Whitelabel UGC: <span class="text-accent">The Complete Guide</span>
        </h1>
        <p class="text-[18px] text-ink-2 max-w-[600px] mx-auto leading-[1.6] mb-8">
          Whitelabel UGC is creator-produced video delivered as raw files. The creator films, the brand owns distribution. You get authentic ad creative without needing the creator's account or audience. $150&ndash;$500 per video.
        </p>
        <div class="flex gap-3 justify-center flex-wrap mb-8">
          <a href={emailSubject} class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-sans text-[14px] font-semibold bg-accent text-white hover:bg-accent-hover transition-all no-underline">Order whitelabel UGC &rarr;</a>
          <a href={calHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-sans text-[14px] font-semibold bg-card text-ink border border-border hover:border-accent hover:text-accent transition-all no-underline">Book a call &rarr;</a>
        </div>
        <div class="flex gap-5 flex-wrap justify-center font-mono text-[12px] text-muted">
          <span>$150&ndash;$500/video</span>
          <span>Raw files</span>
          <span>15&ndash;60s vertical</span>
          <span>Brand controls distribution</span>
          <span>Test at volume</span>
        </div>
      </div>
    </section>

    <!-- How it works grid -->
    <section class="py-8">
      <div class="max-w-[800px] mx-auto px-6">
        <h2 class="font-display text-[22px] font-bold tracking-[-0.02em] text-center mb-5">How Whitelabel UGC Works</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F3AC;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Creator Films</h3>
            <p class="text-[12px] text-muted leading-[1.4]">A real person films the video based on your brief. They appear on camera, demonstrate the product, and deliver raw files.</p>
          </div>
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F4E6;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Brand Receives Files</h3>
            <p class="text-[12px] text-muted leading-[1.4]">You get the raw video files. Edit, add captions, swap hooks, remix for different platforms &mdash; full creative control.</p>
          </div>
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F680;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Run as Paid Ads</h3>
            <p class="text-[12px] text-muted leading-[1.4]">Use the content as paid ad creative on any platform. No creator account access needed. No ongoing creator involvement.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TOC -->
    <section class="py-10 border-t border-b border-border">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-muted-2 mb-4">Contents</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
          {[
            { num: "01", text: "Overview", href: "#overview" },
            { num: "02", text: "What Is Whitelabel UGC?", href: "#what" },
            { num: "03", text: "Whitelabel vs Canvas vs Whitelisting", href: "#comparison" },
            { num: "04", text: "Pricing & Deliverables", href: "#pricing" },
            { num: "05", text: "Best Use Cases", href: "#use-cases" },
            { num: "06", text: "Brief Structure", href: "#briefing" },
            { num: "07", text: "Quality Control & Revisions", href: "#quality" },
            { num: "08", text: "Volume Testing Strategy", href: "#volume" },
            { num: "09", text: "Common Mistakes", href: "#mistakes" },
            { num: "10", text: "Glossary", href: "#glossary" },
            { num: "11", text: "FAQ", href: "#faq" },
          ].map((item) => (
            <a href={item.href} class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[14px] text-ink-2 font-medium hover:bg-bg-alt transition-colors no-underline">
              <span class="font-mono text-[11px] font-medium text-accent min-w-[22px]">{item.num}</span>
              {item.text}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 01 Overview -->
    <section class="guide-section" id="overview">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">01 &mdash; Overview</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Creator produces, brand distributes</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Whitelabel UGC = creator films video, delivers raw files to the brand</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Brand controls editing, captions, distribution, and all ad placements</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Not posted on the creator's account or the brand's organic &mdash; used as paid ad material</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Whitelabel UGC is the simplest creator content model. A brand pays a creator to film a video. The creator appears on camera, demonstrates the product, follows the brief, and delivers raw video files. The brand takes those files and uses them however they want: as <a href="/ugc-ads" class="text-accent hover:underline">paid ads</a>, on landing pages, in emails, as social proof on product pages. The creator's job ends at delivery.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">The content is never posted on the creator's personal account. It's not posted on the brand's organic social either (though it can be). It's built specifically to be ad creative &mdash; raw material the brand's media team edits, tests, and scales.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">This is the most common UGC production model in performance marketing. It's straightforward: the brand buys content, not distribution. The creator is a production resource. The brand handles everything else.</p>
        <ul class="list-none p-0 space-y-2">
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[120px]">Deliverables:</strong> raw video files (MP4), typically 15&ndash;60 seconds, vertical (9:16)</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[120px]">Pricing:</strong> $150&ndash;$500 per video</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[120px]">Usage:</strong> paid ads, landing pages, social proof, email</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[120px]">Creator involvement:</strong> ends at file delivery</li>
        </ul>
      </div>
    </section>

    <!-- 02 What Is Whitelabel UGC -->
    <section class="guide-section" id="what">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">02 &mdash; Definition</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">What is whitelabel UGC?</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Creator films content, delivers raw video files to the brand</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">The creator appears on camera but has no role in distribution</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Brand can edit, remix, add captions, test hooks &mdash; full creative control</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Whitelabel UGC</strong> is a content production model where a creator films video content based on a brand's brief and delivers the raw files. The creator appears on camera &mdash; they are a real person talking about, using, or demonstrating the product &mdash; but they have no involvement in how the content is distributed. The brand owns the files and controls everything after delivery.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">A quick example</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">A supplement brand pays a creator $200 to film a 30-second testimonial about their protein powder. The creator films in their kitchen, talks about their morning routine, and shows themselves making a shake. They export the video and send the raw MP4 file to the brand. The brand adds captions, creates three versions with different hooks, and runs them all as paid ads on Instagram Reels. The creator is done after delivery &mdash; no posting, no account access, no ongoing involvement.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Why brands choose whitelabel UGC</h3>
        <ul class="pl-5 mb-4 space-y-2 text-ink-2">
          <li><strong>Full creative control</strong> &mdash; the brand can edit the footage, swap hooks, add branded captions, and create multiple variants from a single shoot</li>
          <li><strong>No creator account needed</strong> &mdash; unlike <a href="/ugc-whitelisting" class="text-accent hover:underline">whitelisting</a>, the brand doesn't need access to the creator's social account</li>
          <li><strong>Simplest model</strong> &mdash; no ongoing relationship, no account permissions, no authorization codes. Pay, receive files, done.</li>
          <li><strong>Remix potential</strong> &mdash; one raw video can be cut into multiple ad variants: different hooks, different lengths, different CTAs</li>
          <li><strong>Multi-platform use</strong> &mdash; the same files can be used across Meta, TikTok, YouTube, landing pages, and email</li>
        </ul>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">What whitelabel UGC is not</h3>
        <ul class="pl-5 mb-4 space-y-2 text-ink-2">
          <li><strong>Not <a href="/ugc-whitelisting" class="text-accent hover:underline">whitelisting</a></strong> &mdash; in whitelisting, ads run from the creator's account. In whitelabel, ads run from the brand's account using the creator's video files.</li>
          <li><strong>Not <a href="/canvas-ugc" class="text-accent hover:underline">Canvas UGC</a></strong> &mdash; in Canvas, creators post on brand-owned social accounts. In whitelabel, content is delivered as files and never posted organically.</li>
          <li><strong>Not influencer marketing</strong> &mdash; the creator's audience is completely irrelevant. The brand is buying video production, not reach.</li>
          <li><strong>Not stock video</strong> &mdash; whitelabel UGC features a real person using and talking about a specific product. It's custom, not generic.</li>
        </ul>
      </div>
    </section>

    <!-- 03 Comparison -->
    <section class="guide-section" id="comparison">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">03 &mdash; Comparison</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Whitelabel vs Canvas vs Whitelisting</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Three different models for using creator content</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Whitelabel: brand gets files, runs ads from brand account</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Each model serves different strategic goals</li>
          </ul>
        </div>

        <div class="overflow-x-auto rounded-xl border border-border bg-card mb-6">
          <table class="w-full border-collapse text-[14px]">
            <thead class="bg-bg">
              <tr>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Aspect</th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Whitelabel UGC</th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border"><a href="/canvas-ugc" class="text-accent hover:underline">Canvas UGC</a></th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border"><a href="/ugc-whitelisting" class="text-accent hover:underline">Whitelisting</a></th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">What brand gets</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Raw video files</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Content on brand's social accounts</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Ads running from creator's account</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Ads run from</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Brand's ad account</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Brand's accounts (organic, then paid)</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Creator's personal account</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Creator's role</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Film and deliver files</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Post on brand accounts, ongoing</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Film, post, and grant ad access</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Pricing</td><td class="px-4 py-2.5 border-b border-border text-ink-2">$150&ndash;$500 per video (flat fee)</td><td class="px-4 py-2.5 border-b border-border text-ink-2">CPM $2&ndash;$6 per 1K views</td><td class="px-4 py-2.5 border-b border-border text-ink-2">$200&ndash;$1,000 per video</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Brand control</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Maximum &mdash; owns files, full editing rights</td><td class="px-4 py-2.5 border-b border-border text-ink-2">High &mdash; owns account and content</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Moderate &mdash; controls ad, not creator profile</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Operational complexity</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Low &mdash; standard freelancer workflow</td><td class="px-4 py-2.5 border-b border-border text-ink-2">High &mdash; multi-creator, multi-account ops</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Medium &mdash; contracts + platform permissions</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Creator account needed?</td><td class="px-4 py-2.5 border-b border-border text-ink-2">No</td><td class="px-4 py-2.5 border-b border-border text-ink-2">No (brand's accounts)</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Yes (creator grants access)</td></tr>
              <tr><td class="px-4 py-2.5 text-ink">Best for</td><td class="px-4 py-2.5 text-ink-2">Paid ad creative library</td><td class="px-4 py-2.5 text-ink-2">Organic content engine</td><td class="px-4 py-2.5 text-ink-2">Maximum native ad performance</td></tr>
            </tbody>
          </table>
        </div>

        <p class="text-ink-2 leading-[1.65] mb-4">These three models are not competitors &mdash; they serve different purposes. Many brands use all three: whitelabel UGC for their paid ad creative library, <a href="/canvas-ugc" class="text-accent hover:underline">Canvas UGC</a> for organic reach on brand accounts, and <a href="/ugc-whitelisting" class="text-accent hover:underline">whitelisting</a> for maximum paid ad performance from creator accounts. The right model depends on your primary goal.</p>
      </div>
    </section>

    <!-- 04 Pricing & Deliverables -->
    <section class="guide-section" id="pricing">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">04 &mdash; Pricing</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Pricing and deliverables</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">$150&ndash;$500 per video, depending on complexity and creator experience</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Deliverables: raw MP4 files, 15&ndash;60 seconds, vertical 9:16</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Volume discounts available at 10+ videos per order</li>
          </ul>
        </div>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Pricing breakdown</h3>
        <div class="overflow-x-auto rounded-xl border border-border bg-card mb-6">
          <table class="w-full border-collapse text-[14px]">
            <thead class="bg-bg">
              <tr>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Video type</th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Price range</th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">What's included</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Simple testimonial</td><td class="px-4 py-2.5 border-b border-border text-ink-2">$150&ndash;$200</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Talking head, single location, basic brief</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Product demo</td><td class="px-4 py-2.5 border-b border-border text-ink-2">$200&ndash;$350</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Product shown in use, multiple angles or settings</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Screen recording + voiceover</td><td class="px-4 py-2.5 border-b border-border text-ink-2">$200&ndash;$350</td><td class="px-4 py-2.5 border-b border-border text-ink-2">App/software demo with narration (<a href="/tech-ugc" class="text-accent hover:underline">Tech UGC</a>)</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Before/after</td><td class="px-4 py-2.5 border-b border-border text-ink-2">$250&ndash;$400</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Transformation sequence, multiple takes needed</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Complex storyline</td><td class="px-4 py-2.5 border-b border-border text-ink-2">$350&ndash;$500</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Multiple scenes, locations, or props. Higher production value.</td></tr>
              <tr><td class="px-4 py-2.5 text-ink">Volume order (10+ videos)</td><td class="px-4 py-2.5 text-ink-2">10&ndash;20% discount</td><td class="px-4 py-2.5 text-ink-2">Batch pricing for creative testing programs</td></tr>
            </tbody>
          </table>
        </div>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Standard deliverables</h3>
        <ul class="pl-5 mb-4 space-y-2 text-ink-2">
          <li><strong>File format:</strong> MP4 (H.264 or H.265)</li>
          <li><strong>Resolution:</strong> 1080x1920 minimum (vertical 9:16)</li>
          <li><strong>Duration:</strong> 15&ndash;60 seconds per video</li>
          <li><strong>Includes:</strong> raw footage + creator's basic edit (cuts, pacing)</li>
          <li><strong>Does not include:</strong> captions, motion graphics, color grading, music (brand adds these post-delivery)</li>
          <li><strong>Revisions:</strong> typically 1&ndash;2 revision rounds included in the price</li>
        </ul>

        <p class="text-ink-2 leading-[1.65] mb-4">The brand receives clean raw files that can be edited, remixed, and reformatted freely. This is the key advantage of whitelabel: the brand's media team can create multiple ad variants from a single raw video &mdash; different hooks, different captions, different lengths &mdash; without going back to the creator.</p>
      </div>
    </section>

    <!-- 05 Best Use Cases -->
    <section class="guide-section" id="use-cases">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">05 &mdash; Use Cases</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Best use cases for whitelabel UGC</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Paid ad creative library &mdash; the primary use case</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Landing page videos &mdash; social proof above the fold</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Email and retargeting &mdash; authentic content in owned channels</li>
          </ul>
        </div>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Primary use cases</h3>
        <ul class="pl-5 mb-4 space-y-2 text-ink-2">
          <li><strong>Paid ad creative library</strong> &mdash; the most common use case. Brands order 10&ndash;20 whitelabel videos per month to feed their <a href="/guide" class="text-accent hover:underline">creative testing</a> pipeline. Each video becomes 2&ndash;3 ad variants (different hooks, captions, lengths). This gives the media buying team a constant supply of fresh creative.</li>
