        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">11 &mdash; Glossary</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Key terms</h2>
        {[
          { term: "Creator network", def: "An organized, vetted pool of UGC creators that can be deployed for content production on demand. Not a marketplace listing—a managed talent infrastructure." },
          { term: "Managed network", def: "A creator network operated by an agency or production company. The operator handles matching, briefing, QC, and payments on behalf of the client." },
          { term: "Self-serve platform", def: "A marketplace where brands search for and hire creators directly. The platform provides the directory; the brand does the operational work." },
          { term: "Creator vetting", def: "The process of screening creators before adding them to a network. Includes portfolio review, paid test videos, and communication evaluation." },
          { term: "Creator matching", def: "Assigning the right creator to a project based on niche expertise, content style, skill level, availability, and past performance data." },
          { term: "Brief distribution", def: "The process of sending standardized project briefs to matched creators with clear deliverables, brand guidelines, reference examples, and deadlines." },
          { term: "Hit rate", def: "The percentage of produced content that meets performance thresholds in paid advertising. A key measure of network quality and matching accuracy." },
          { term: "Creator retention", def: "The percentage of creators who remain active in a network over time. High retention reduces sourcing costs and maintains institutional knowledge." },
          { term: "Network capacity", def: "The maximum number of deliverables a network can produce in a given period based on its active creator count and average output per creator." },
          { term: "Creator CRM", def: "A database or tool used to track creator profiles, availability, performance history, payment records, and categorization tags within a network." },
        ].map((item) => (
          <div class="py-4 border-b border-border">
