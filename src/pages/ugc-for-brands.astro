import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const faqs = [
  {
    q: "How much does UGC content cost per video?",
    a: "Rates depend on deliverable complexity, usage scope, and creator tier. A single whitelabel video from a mid-level creator typically runs $200 to $450. When you factor in ad usage rights for 90 days across Meta and TikTok, expect $350 to $800 per asset. Volume packages — 10 or more videos per month — bring the per-unit cost down 20 to 35 percent. At OKAD we quote fixed project pricing so there are no surprises.",
  },
  {
    q: "What is the difference between UGC and influencer marketing?",
    a: "Influencer marketing pays for distribution — you are renting someone's audience. UGC pays for production skill — you own the content and run it through your own ad accounts. The creator's follower count is irrelevant in UGC. What matters is their ability to deliver authentic, high-converting video that performs in paid media.",
  },
  {
    q: "How long does it take to receive finished UGC videos?",
    a: "From brief approval to final delivery, most projects take 10 to 14 business days. That includes creator matching (2 to 3 days), product shipping if needed (3 to 5 days), filming and editing (3 to 5 days), and one round of revisions (1 to 2 days). Rush timelines of 5 to 7 days are possible with creators who already have the product.",
  },
  {
    q: "Do we need to ship products to every creator?",
    a: "For physical products, yes — creators need the real item to film authentic content. Digital products, apps, and services can be demonstrated via screen recordings or access credentials. At OKAD we coordinate all product shipments, provide tracking, and confirm receipt before filming begins.",
  },
  {
    q: "Can we use UGC videos as paid ads?",
    a: "Yes, and that is the primary use case. UGC videos consistently outperform studio-produced ads on Meta, TikTok, and YouTube Shorts. The key is securing proper usage rights upfront. Every OKAD contract includes ad usage licensing with clear duration and platform terms so your media buying team can run campaigns without legal ambiguity.",
  },
  {
    q: "How do you match creators to our brand?",
    a: "We filter from our network of 700+ vetted creators based on product category, target demographic, content style, language, and location. You receive a shortlist of 3 to 5 creators with portfolio samples relevant to your niche. You approve the final selection before any filming begins.",
  },
];
