            <p>
              UGC pricing has three components that should always be quoted separately: the creation fee, usage rights, and any add-ons like raw footage delivery or additional hooks.
            </p>
          </div>

          <!-- Pricing Table -->
          <div class="overflow-x-auto my-8">
            <table class="w-full text-[14px] border-collapse">
              <thead>
                <tr class="border-b-2 border-border">
                  <th class="text-left font-display font-semibold text-ink py-3 pr-4">Deliverable</th>
                  <th class="text-left font-display font-semibold text-ink py-3 pr-4">Entry-Level Creator</th>
                  <th class="text-left font-display font-semibold text-ink py-3 pr-4">Mid-Level Creator</th>
                  <th class="text-left font-display font-semibold text-ink py-3">Top-Tier Creator</th>
                </tr>
              </thead>
