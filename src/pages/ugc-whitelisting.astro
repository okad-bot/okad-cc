        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Key terms</h2>

        {[
          { term: "Whitelisting", def: "The practice of running paid ads from a creator's personal social media account instead of the brand's account. Also called creator licensing or allowlisting." },
          { term: "Spark Ads", def: "TikTok's native whitelisting format. The brand boosts an existing creator post as a paid ad. All engagement stays on the creator's original post." },
          { term: "Partnership Ads", def: "Meta's whitelisting format (Instagram and Facebook). The creator tags the brand as a paid partner, allowing the brand to run the post as an ad." },
          { term: "Branded Content tool", def: "Meta's feature that enables creators to tag brands and grant ad promotion permissions. The gateway to Partnership Ads." },
          { term: "Authorization code", def: "A code generated by a TikTok creator that allows a brand to run their video as a Spark Ad. Expires after 7, 30, or 60 days." },
          { term: "Allowlisting", def: "Alternative term for whitelisting, used by some agencies and platforms. Same concept — running ads from the creator's account." },
          { term: "Creator licensing", def: "Another term for whitelisting. Emphasizes that the brand is licensing the right to use the creator's account for ads." },
          { term: "Brand-handle ads", def: "Standard paid ads that run from the brand's own social account. The baseline against which whitelisted ads are compared." },
          { term: "CPM", def: "Cost per mille — cost per 1,000 ad impressions. Whitelisted ads typically achieve 40% lower CPMs than brand-handle ads." },
          { term: "CPA", def: "Cost per acquisition — cost to generate one purchase, install, or signup. Whitelisted ads typically achieve 50% lower CPA." },
          { term: "Whitelabel UGC", def: "A different model: creator delivers raw video files, brand runs ads from brand's account. Distinct from whitelisting, where ads run from the creator's account." },
        ].map((item) => (
