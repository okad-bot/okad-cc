        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Key terms</h2>

        {[
          { term: "Modular creative", def: "A production methodology where video ads are built from interchangeable components (hooks, bodies, CTAs) rather than produced as single, complete units." },
          { term: "Component", def: "An individual, self-contained piece of a modular ad: a hook, a body narrative, a product demo, a social proof clip, a CTA, or a text overlay." },
          { term: "Hook", def: "The first 3 seconds of a video ad. The highest-leverage component — tested first in the modular framework." },
          { term: "Body narrative", def: "The core content of the ad (5-20 seconds): problem/solution, product demonstration, testimonial, or educational content." },
          { term: "CTA (call to action)", def: "The closing component (2-5 seconds): 'Try it free,' 'Link in bio,' 'Get 20% off.' Lowest leverage — tested last." },
          { term: "Super / text overlay", def: "Bold text placed on the video to reinforce key messages. Can be swapped independently of other components." },
          { term: "Component-level analytics", def: "Aggregating ad performance data by individual component to identify which hook, body, or CTA drives results — not just which ad won." },
          { term: "Naming convention", def: "Systematic file naming ([concept]_[hook]_[body]_[cta]) that enables component-level tracking and analytics." },
          { term: "Batch shooting", def: "Recording all components of one type in a single session — e.g., all hooks at once, all demos at once — for production efficiency." },
          { term: "Creative fatigue", def: "The decline in ad performance from audience overexposure. Modular creative extends lifespan by enabling rapid variation production." },
          { term: "Dynamic Creative Optimization (DCO)", def: "Platform-side automated variation of ad elements. Different from modular creative, which is production-side intentional variation." },
        ].map((item) => (
          <div class="py-4 border-b border-border">
            <div class="font-display font-semibold text-ink mb-1">{item.term}</div>
            <div class="text-[14px] text-muted">{item.def}</div>
          </div>
        ))}
      </div>
    </section>

