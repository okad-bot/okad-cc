  {
    title: "Creative Testing",
    subtitle: "The complete guide to paid ad experimentation",
    href: "/guide",
    tag: "Strategy",
    bg: "from-[#6366F1] to-[#4F46E5]",
    tagBg: "bg-white/20",
  },
  {
    title: "Canvas UGC",
    subtitle: "Brand-account content at scale",
    href: "/canvas-ugc",
    tag: "Content Model",
    bg: "from-[#1a1a1f] to-[#2a2a2f]",
    tagBg: "bg-white/15",
  },
  {
    title: "Tech UGC",
    subtitle: "Creator-made software content",
    href: "/tech-ugc",
    tag: "Content Model",
    bg: "from-[#9333EA] to-[#7C3AED]",
    tagBg: "bg-white/20",
  },
  {
    title: "UGC Ads",
    subtitle: "Creator content as paid advertising",
    href: "/ugc-ads",
    tag: "Ads",
    bg: "from-[#059669] to-[#047857]",
    tagBg: "bg-white/20",
  },
  {
    title: "Spark Ads",
    subtitle: "TikTok's organic-to-paid format",
    href: "/spark-ads",
    tag: "Platform",
    bg: "from-[#111] to-[#EE1D52]",
    tagBg: "bg-white/15",
  },
  {
    title: "Partnership Ads",
    subtitle: "Meta's creator ad format",
    href: "/partnership-ads",
    tag: "Platform",
    bg: "from-[#1877F2] to-[#0C5DC7]",
    tagBg: "bg-white/20",
  },
  {
    title: "Hook Rate",
    subtitle: "The 3-second metric that predicts everything",
    href: "/hook-rate",
    tag: "Metrics",
    bg: "from-[#F59E0B] to-[#D97706]",
    tagBg: "bg-black/15",
  },
  {
    title: "Ad Fatigue",
    subtitle: "Why winning ads stop working",
    href: "/ad-fatigue",
    tag: "Metrics",
    bg: "from-[#DC2626] to-[#B91C1C]",
    tagBg: "bg-white/20",
  },
  {
    title: "Performance Creative",
    subtitle: "Data-driven ad production",
    href: "/performance-creative",
    tag: "Strategy",
    bg: "from-[#6366F1] to-[#9333EA]",
    tagBg: "bg-white/20",
  },
  {
    title: "Modular Creative",
    subtitle: "6 hooks × 4 bodies × 3 CTAs = 72 ads",
    href: "/modular-creative",
    tag: "Strategy",
    bg: "from-[#0891B2] to-[#0E7490]",
    tagBg: "bg-white/20",
  },
  {
    title: "UGC Whitelisting",
    subtitle: "Running ads from creator accounts",
    href: "/ugc-whitelisting",
    tag: "Ads",
    bg: "from-[#7C3AED] to-[#5B21B6]",
    tagBg: "bg-white/20",
  },
  {
    title: "Whitelabel UGC",
    subtitle: "Creator content for your ad library",
    href: "/whitelabel-ugc",
    tag: "Content Model",
    bg: "from-[#1a1a1f] to-[#374151]",
    tagBg: "bg-white/15",
  },
  {
    title: "High-Volume UGC",
    subtitle: "50–300+ videos per month",
    href: "/high-volume-ugc",
    tag: "Content Model",
    bg: "from-[#059669] to-[#0891B2]",
    tagBg: "bg-white/20",
  },
