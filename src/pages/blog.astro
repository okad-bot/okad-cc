---

<Layout
  title="Blog — Open Guides on UGC, Creative Testing & Paid Ads | OKAD"
  description="17 in-depth guides on Canvas UGC, Tech UGC, creative testing, Spark Ads, hook rate, ad fatigue, and more. Free, research-based resources by OKAD Agency."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="pt-20 md:pt-24 pb-8 text-center bg-bg">
      <div class="max-w-[960px] mx-auto px-6">
        <div class="inline-flex items-center gap-1.5 text-[12px] font-medium text-accent bg-[rgba(99,102,241,.06)] border border-[rgba(99,102,241,.18)] rounded-full px-3.5 py-1.5 mb-5">
          {guides.length} open guides &middot; September 2026
        </div>
        <h1 class="font-display font-bold text-[clamp(28px,5vw,44px)] leading-[1.1] tracking-[-0.03em] text-ink mb-3">
          The OKAD <span class="text-accent">Knowledge Base</span>
        </h1>
        <p class="text-[17px] text-ink-2 max-w-[540px] mx-auto leading-[1.6] mb-6">
          Research-based guides on UGC, creative testing, and paid ads. Written for brands and operators who want to understand how things actually work.
        </p>
      </div>
    </section>

    <!-- Filter tags -->
    <section class="pb-6">
      <div class="max-w-[960px] mx-auto px-6">
        <div class="flex gap-2 flex-wrap justify-center">
          <button class="filter-btn active" data-filter="all">All</button>
          <button class="filter-btn" data-filter="Strategy">Strategy</button>
          <button class="filter-btn" data-filter="Content Model">Content Model</button>
          <button class="filter-btn" data-filter="Ads">Ads</button>
          <button class="filter-btn" data-filter="Platform">Platform</button>
          <button class="filter-btn" data-filter="Metrics">Metrics</button>
          <button class="filter-btn" data-filter="Creators">Creators</button>
        </div>
      </div>
    </section>

    <!-- Grid -->
    <section class="pb-16">
      <div class="max-w-[960px] mx-auto px-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5" id="guides-grid">
          {guides.map((g) => (
            <a href={g.href} class="guide-card group block no-underline" data-tag={g.tag}>
              <div class="cover-wrap" style={`background: ${g.bg};`}>
                <!-- Noise texture overlay -->
                <div class={`cover-noise ${g.noise}`}></div>

                <!-- Content -->
                <div class="cover-content">
                  <!-- Tag -->
                  <div class="cover-tag">{g.tag}</div>

                  <!-- Quote with highlight strips -->
                  <div class="cover-quote">
                    <span class="cover-highlight">{g.quote}</span>
                  </div>

                  <!-- Title & subtitle -->
                  <div class="cover-bottom">
                    <h2 class="cover-title">{g.title}</h2>
                    <p class="cover-sub">{g.subtitle}</p>
                  </div>

                  <!-- OKAD badge -->
                  <div class="cover-badge">
                    <span class="cover-badge-text">OKAD</span>
                  </div>
                </div>

                <!-- Character emoji -->
                <div class="cover-char" set:html={g.emoji} />

                <!-- Arrow on hover -->
                <div class="cover-arrow">&rarr;</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="pb-16">
      <div class="max-w-[960px] mx-auto px-6">
        <div class="bg-dark rounded-2xl p-10 md:p-14 text-center">
          <h2 class="font-display font-bold text-[clamp(22px,3.5vw,32px)] tracking-[-0.02em] text-white mb-3">Need help implementing any of this?</h2>
          <p class="text-[15px] text-muted max-w-[480px] mx-auto leading-[1.6] mb-6">OKAD handles creative testing, UGC production, and paid ad creative for DTC and tech brands. Tell us what you need.</p>
          <div class="flex gap-3 justify-center flex-wrap">
            <a href="mailto:olga@okad.agency?subject=OKAD%20%E2%80%94%20tell%20us%20about%20your%20brand" class="inline-flex items-center px-5 py-2.5 rounded-xl font-sans text-[14px] font-semibold bg-white text-ink hover:bg-[rgba(99,102,241,.06)] hover:text-accent transition-all no-underline">Write to us &rarr;</a>
            <a href="https://calendly.com/okad_calls/first" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 rounded-xl font-sans text-[14px] font-semibold text-muted border border-white/15 hover:text-white hover:border-white/30 transition-all no-underline">Book a call &rarr;</a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "OKAD Agency Blog — UGC Guides & Resources",
  "url": "https://okad.cc/blog/",
  "description": "Guides and resources about UGC content creation, pricing, contracts, and brand partnerships.",
  "publisher": {
    "@type": "Organization",
    "name": "OKAD Agency"
  }
})} />
</Layout>

<style>
  /* Filter buttons */
  .filter-btn {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .06em;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-muted);
    cursor: pointer;
    transition: all .15s;
  }
  .filter-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .filter-btn.active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }

  /* Card */
  .guide-card {
    transition: transform .2s, box-shadow .2s;
  }
  .guide-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,.15);
  }
  .guide-card.hidden {
    display: none;
  }

  /* Cover */
  .cover-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    aspect-ratio: 16 / 10;
    display: flex;
  }

  /* Noise texture */
  .cover-noise {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 128px 128px;
    pointer-events: none;
  }
  .cover-noise.warm { opacity: 0.18; }

  /* Content layout */
  .cover-content {
    position: relative;
    z-index: 2;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    min-width: 0;
  }

  /* Tag pill */
  .cover-tag {
    align-self: flex-start;
    background: rgba(255,255,255,.2);
    border-radius: 999px;
    padding: 3px 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: #fff;
  }

  /* Quote with white highlight strips */
  .cover-quote {
    margin: auto 0;
    padding: 8px 0;
  }
  .cover-highlight {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(20px, 3vw, 28px);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #111;
    background: #fff;
    padding: 2px 8px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  /* Bottom info */
  .cover-bottom {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cover-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 13px;
    color: #fff;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .cover-sub {
    font-family: var(--font-sans);
    font-size: 11px;
    color: rgba(255,255,255,.65);
    margin: 0;
    line-height: 1.3;
  }

  /* OKAD badge */
  .cover-badge {
    position: absolute;
    bottom: 20px;
    right: 24px;
    z-index: 3;
  }
  .cover-badge-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: -0.02em;
    color: #fff;
    background: rgba(0,0,0,.3);
    backdrop-filter: blur(4px);
    padding: 4px 10px;
    border-radius: 6px;
  }

  /* Character emoji */
  .cover-char {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 72px;
    opacity: 0.25;
    z-index: 1;
    pointer-events: none;
    filter: grayscale(0.3);
    transition: opacity .2s, transform .2s;
  }
  .guide-card:hover .cover-char {
    opacity: 0.4;
    transform: translateY(-50%) scale(1.08);
  }

  /* Arrow on hover */
  .cover-arrow {
    position: absolute;
    top: 18px;
    right: 20px;
    z-index: 3;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255,255,255,.15);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: #fff;
    opacity: 0;
    transition: opacity .2s;
  }
  .guide-card:hover .cover-arrow {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .cover-wrap {
      aspect-ratio: 16 / 11;
    }
    .cover-highlight {
      font-size: 20px;
    }
    .cover-char {
      font-size: 56px;
      right: 10px;
    }
    .cover-content {
      padding: 16px 18px;
    }
    .cover-badge {
      bottom: 16px;
      right: 18px;
    }
  }
</style>

<script>
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.getAttribute('data-filter');
      document.querySelectorAll('.guide-card').forEach(card => {
        if (filter === 'all' || card.getAttribute('data-tag') === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
