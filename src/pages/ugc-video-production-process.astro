---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const emailHref = "mailto:olga@okad.agency?subject=UGC%20video%20production%20inquiry";
const calHref = "https://calendly.com/okad_calls/first";
---

<Layout
  title="UGC Video Production — End-to-End Process for Brands & Creators | OKAD"
  description="Complete guide to UGC video production from brief to delivery. Step-by-step process for brands commissioning creator content and creators filming, editing, and delivering UGC videos."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="pt-20 md:pt-24 pb-10 text-center bg-bg">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="inline-flex items-center gap-1.5 text-[12px] font-medium text-accent bg-[rgba(99,102,241,.06)] border border-[rgba(99,102,241,.18)] rounded-full px-3.5 py-1.5 mb-6">
          Production guide &middot; September 2026
        </div>
        <h1 class="font-display font-bold text-[clamp(28px,5vw,48px)] leading-[1.1] tracking-[-0.03em] text-ink mb-4">
          UGC Video Production: <span class="text-accent">End-to-End Process</span> for Brands &amp; Creators
        </h1>
        <p class="text-[18px] text-ink-2 max-w-[600px] mx-auto leading-[1.6] mb-8">
          The complete production workflow from brief to final delivery &mdash; covering every step on the brand side and the creator side so both parties know exactly what to expect.
        </p>
        <div class="flex gap-3 justify-center flex-wrap mb-8">
          <a href={emailHref} class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-sans text-[14px] font-semibold bg-accent text-white hover:bg-accent-hover transition-all no-underline">Start a UGC project &rarr;</a>
          <a href={calHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-sans text-[14px] font-semibold bg-card text-ink border border-border hover:border-accent hover:text-accent transition-all no-underline">Book a call &rarr;</a>
        </div>
        <div class="flex gap-5 flex-wrap justify-center font-mono text-[12px] text-muted">
          <span>Brief &rarr; Delivery</span>
          <span>7&ndash;14 day cycle</span>
          <span>Brand + Creator POV</span>
          <span>QC checklist</span>
          <span>FAQ</span>
        </div>
      </div>
    </section>

    <!-- How it works grid -->
    <section class="py-8">
      <div class="max-w-[800px] mx-auto px-6">
        <h2 class="font-display text-[22px] font-bold tracking-[-0.02em] text-center mb-5">Two Sides, One Workflow</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F4CB;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Brand Side</h3>
            <p class="text-[12px] text-muted leading-[1.4]">Write the brief, recruit creators, review drafts, approve finals, and scale to dozens of videos per month.</p>
          </div>
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F3AC;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Creator Side</h3>
            <p class="text-[12px] text-muted leading-[1.4]">Interpret the brief, script and plan, film, edit, and deliver polished UGC videos that hit every requirement.</p>
          </div>
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x2705;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Quality &amp; Delivery</h3>
            <p class="text-[12px] text-muted leading-[1.4]">Timeline milestones, QC checklists, and a shared vocabulary that keeps every project on track.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TOC -->
    <section class="py-10 border-t border-b border-border">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-muted-2 mb-4">Contents</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
          {[
            { num: "01", text: "Overview", href: "#overview" },
            { num: "02", text: "Brand Side: Writing the Brief", href: "#brief" },
            { num: "03", text: "Brand Side: Recruiting Creators", href: "#recruiting" },
            { num: "04", text: "Brand Side: Review & Approval", href: "#review" },
            { num: "05", text: "Brand Side: Scaling Production", href: "#scaling" },
            { num: "06", text: "Creator Side: Interpreting the Brief", href: "#interpreting" },
            { num: "07", text: "Creator Side: Scripting & Pre-Production", href: "#scripting" },
            { num: "08", text: "Creator Side: Filming", href: "#filming" },
            { num: "09", text: "Creator Side: Editing & Post-Production", href: "#editing" },
            { num: "10", text: "Creator Side: Delivery & Revisions", href: "#delivery" },
            { num: "11", text: "Timeline & Milestones", href: "#timeline" },
            { num: "12", text: "Quality Control Checklist", href: "#qc" },
            { num: "13", text: "Glossary", href: "#glossary" },
            { num: "14", text: "FAQ", href: "#faq" },
          ].map((item) => (
            <a href={item.href} class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[14px] text-ink-2 font-medium hover:bg-bg-alt transition-colors no-underline">
              <span class="font-mono text-[11px] font-medium text-accent min-w-[22px]">{item.num}</span>
              {item.text}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 01 Overview -->
    <section class="guide-section" id="overview">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">01 &mdash; Overview</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">The end-to-end UGC video production process</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">UGC video production is a structured workflow, not an ad-hoc creative exercise</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">A clear process reduces revision cycles by 40&ndash;60% and cuts delivery time in half</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">This guide covers both the brand side and the creator side of every stage</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">User-generated content video production involves a series of interdependent steps: writing the brief, finding and vetting creators, scripting, filming, editing, reviewing, and delivering final assets. When any step is vague or poorly executed, the downstream effects compound. A weak brief produces off-target footage. Unclear feedback creates endless revision loops. Missing specs mean rework at the finish line.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">The difference between brands that get great UGC consistently and those that struggle is almost never talent. It is process. Brands with a documented production workflow &mdash; from the brief template they send to the naming convention they require on delivered files &mdash; get better content faster, with fewer revisions, at lower cost. Creators who follow a disciplined pre-production and delivery process earn more repeat work and higher rates.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">This guide walks through the complete production cycle from two parallel perspectives. Sections 2&ndash;5 cover the brand side: how to write briefs, recruit creators, run reviews, and scale output. Sections 6&ndash;10 cover the creator side: how to interpret briefs, plan shoots, film, edit, and deliver. Sections 11&ndash;12 cover the shared infrastructure &mdash; timelines, milestones, and quality control &mdash; that keeps both sides aligned. Whether you are a <a href="/ugc-team-vs-agency/" class="text-accent hover:underline">brand building an in-house team or evaluating agencies</a>, or a <a href="/ugc-creator/" class="text-accent hover:underline">creator looking to professionalize your workflow</a>, every stage is covered.</p>
      </div>
    </section>

    <!-- 02 Brand Side: Writing the Brief -->
    <section class="guide-section" id="brief">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">02 &mdash; Brand Side</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Writing the brief</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">The brief is the single highest-leverage document in UGC production</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Include: product info, audience, key messages, format specs, references, do's &amp; don'ts</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">A good brief takes 30 minutes to write and saves 5+ hours of revisions</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">The brief determines everything. A detailed, well-structured brief is the single most effective way to reduce revision rounds, shorten production timelines, and get content that actually converts. Vague briefs &mdash; "just make it feel authentic" &mdash; produce vague content. Specific briefs produce specific, on-target videos.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Every UGC brief should include six core elements. First, <strong>product information</strong>: what the product is, what it does, what makes it different, and any claims the creator can or cannot make. Second, <strong>target audience</strong>: who will see this video, what they care about, and what objections they might have. Third, <strong>key messages</strong>: the 2&ndash;3 points the video must communicate, in priority order. Fourth, <strong>format specifications</strong>: aspect ratio (9:16 for TikTok/Reels, 1:1 for feed), duration range, and platform. Fifth, <strong>reference videos</strong>: 2&ndash;3 examples of the tone, pacing, and style you want, with notes on what specifically you like about each. Sixth, <strong>do's and don'ts</strong>: explicit guardrails on language, competitor mentions, visual elements, and anything that would violate brand or legal guidelines.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Brief template structure</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">We recommend using a standardized template rather than writing each brief from scratch. Templates ensure nothing gets missed and allow creators to quickly find the information they need. Our <a href="/ugc-brief-templates/" class="text-accent hover:underline">UGC brief templates</a> page includes ready-to-use formats for testimonial videos, unboxing content, problem-solution ads, and tutorial-style UGC. Each template includes placeholder text and notes explaining what to include in each section.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">One common mistake is overloading the brief with too many messages. A 30&ndash;60 second UGC video can effectively communicate one primary message and one supporting point. Trying to pack in five talking points results in a video that communicates none of them well. Prioritize ruthlessly, and save additional messages for separate videos.</p>
      </div>
    </section>

    <!-- 03 Brand Side: Recruiting Creators -->
    <section class="guide-section" id="recruiting">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">03 &mdash; Brand Side</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Recruiting creators</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Source from UGC platforms, agencies, social media, and creator networks</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Vet portfolios for production quality, not follower count</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Always run a paid trial video before committing to a roster spot</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Finding the right creators is the second most important factor in UGC production, after the brief itself. The goal is not to find influencers with large followings &mdash; UGC creators are hired for their on-camera presence, production skills, and ability to follow a brief, not their audience size. Look for creators whose natural speaking style, appearance, and energy match your target customer demographic.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">There are four primary sourcing channels. <strong>UGC platforms</strong> like Billo, Insense, and Trend aggregate creator portfolios and handle contracts and payments. They are the fastest way to find creators but offer limited vetting. <strong>Agencies</strong> &mdash; including <a href="/ugc-team-vs-agency/" class="text-accent hover:underline">specialized UGC agencies</a> &mdash; maintain curated rosters and handle the entire matching process. <strong>Social media outreach</strong> involves searching hashtags like #ugccreator on TikTok and Instagram to find creators organically. <strong>Creator networks</strong> are referral-based communities where established creators recommend peers. For understanding <a href="/ugc-rates/" class="text-accent hover:underline">typical UGC rates</a>, we have a separate guide.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Vetting and trial videos</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">When reviewing portfolios, evaluate three things: video quality (lighting, audio, framing), delivery quality (natural speech, pacing, energy), and brief adherence (does the creator's past work show they can follow specific direction, or do they only produce one style?). A polished portfolio reel is not enough &mdash; reels show the creator's best work, not their average output.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Run a paid trial before adding any creator to your regular roster. Send them a real brief for a real product and evaluate the full cycle: how quickly they respond, whether they ask clarifying questions, the quality of the first draft, and how they handle feedback. Trial videos cost $50&ndash;$200 depending on the creator's rate, and they are the most cost-effective way to avoid mismatches that waste thousands of dollars later.</p>
      </div>
    </section>

    <!-- 04 Brand Side: Review & Approval -->
    <section class="guide-section" id="review">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">04 &mdash; Brand Side</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Review &amp; approval</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Review raw footage first to catch issues before editing begins</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Give timestamped, specific feedback &mdash; never just "make it better"</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Set clear revision limits (typically 2 rounds) and turnaround windows</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">The review stage is where most UGC projects either stay on track or spiral into costly back-and-forth. The key to efficient reviews is structure: a defined approval workflow with clear criteria, specific feedback, and limited revision rounds.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Implement a two-stage review process. The first review happens on <strong>raw footage</strong>, before editing. This is where you check that the creator filmed in the right setting, used the product correctly, hit the key talking points, and delivered the right energy. Catching problems at this stage avoids wasting editing time. The second review happens on the <strong>edited draft</strong>, where you evaluate pacing, captions, music, transitions, and overall polish.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Feedback must be specific and actionable. Instead of "the energy is off," say "at 0:08&ndash;0:15, the delivery feels rehearsed &mdash; please re-record this section in a more conversational tone, as if you are telling a friend about the product." Timestamped notes eliminate ambiguity and reduce revision cycles. Tools like Frame.io, Wipster, or even a simple shared Google Doc with timestamp references work well for asynchronous review.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Revision limits and timelines</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">Standard practice is two revision rounds included in the base rate, with additional rounds billed separately. This protects both parties: the brand gets reasonable opportunity to refine the content, and the creator is not locked into unlimited free rework. Set clear turnaround expectations &mdash; typically 24&ndash;48 hours for brand feedback and 24&ndash;48 hours for creator revisions. Delays on either side push the entire timeline back.</p>
      </div>
    </section>

    <!-- 05 Brand Side: Scaling Production -->
    <section class="guide-section" id="scaling">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">05 &mdash; Brand Side</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Scaling production</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Going from 5 to 50+ videos/month requires modular production, not more effort</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Build a rotating creator roster with 3&times; your minimum delivery requirement</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Content calendars and batch briefing are non-negotiable at scale</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Scaling UGC production from a handful of videos to <a href="/high-volume-ugc/" class="text-accent hover:underline">50+ videos per month</a> is not a matter of doing the same thing faster. It requires a fundamentally different operating model: modular production, creator rosters, batch briefing, and content calendars that plan 4&ndash;6 weeks ahead.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Modular production means breaking the creative process into interchangeable components. Instead of scripting each video from scratch, create a library of hook templates, talking-point frameworks, and CTA variants. A single product can generate dozens of videos by mixing different hooks with different creator styles and different CTAs. This approach is detailed in our <a href="/ugc-scaling/" class="text-accent hover:underline">UGC scaling guide</a>.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Creator rosters and content calendars</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">Maintain a creator roster that is 3&times; your minimum delivery target. If you need 10 videos per week, have 30 active creators available. This accounts for scheduling conflicts, variable output quality, and the 10&ndash;20% monthly churn that is normal in creator pools. Organize creators into tiers based on reliability and quality, and assign high-priority briefs to top-tier creators.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Build a content calendar that maps out themes, product launches, seasonal hooks, and platform trends 4&ndash;6 weeks in advance. Batch-send briefs weekly rather than one at a time. This allows creators to plan their filming schedules and gives your review team predictable workloads. At the 50+ video stage, dedicated production management &mdash; either in-house or through an agency &mdash; becomes essential.</p>
      </div>
    </section>

    <!-- 06 Creator Side: Interpreting the Brief -->
    <section class="guide-section" id="interpreting">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">06 &mdash; Creator Side</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Receiving &amp; interpreting the brief</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Read the entire brief before responding &mdash; most questions are answered in the document</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Ask clarifying questions upfront, not after filming</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Confirm deliverables, timeline, and format specs in writing</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">The moment you receive a brief is the most important point in the entire production cycle. How you handle the next 30 minutes determines whether the project goes smoothly or becomes a revision nightmare. Read the entire document from start to finish before doing anything else. Do not skim. Pay attention to the do's and don'ts section, the format specifications, and the reference videos.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">After reading, make a checklist of the deliverables: number of videos, aspect ratio, duration range, number of hooks, whether raw footage is required alongside edited versions, and the delivery deadline. If anything is ambiguous &mdash; a vague target audience description, conflicting reference videos, unclear product claims &mdash; ask now. Send your questions in a single, organized message rather than peppering the brand with one-off messages over several days.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Confirm the timeline in writing. If the brief says "delivery by Friday" but you know you cannot film until Thursday due to a product shipment delay, say so immediately. Brands would rather adjust the timeline upfront than discover on Friday that the content is not ready. Professionalism at this stage is what separates creators who get repeat bookings from those who do not.</p>
      </div>
    </section>

    <!-- 07 Creator Side: Scripting & Pre-Production -->
    <section class="guide-section" id="scripting">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">07 &mdash; Creator Side</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Scripting &amp; pre-production</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Write a script or outline before filming &mdash; improvising wastes time</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Create a shot list that maps each scene to the script</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Prepare your filming setup the day before the shoot</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Good UGC looks spontaneous. It is not. The best-performing creator videos are carefully planned to feel natural. This planning happens in pre-production: scripting, shot listing, and setup preparation. Skipping this step is the most common reason creators need multiple filming sessions to get usable footage.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Start with the brief's key messages and structure them into a narrative arc. The standard UGC script structure is: <strong>hook</strong> (first 2&ndash;3 seconds to stop the scroll), <strong>problem or context</strong> (why the viewer should care), <strong>solution or demonstration</strong> (the product in action), and <strong>CTA</strong> (what the viewer should do next). Write 2&ndash;3 hook variants for each video &mdash; this gives the brand options to test without requiring a full reshoot.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Shot lists and setup</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">Translate your script into a shot list. For each scene, note the camera angle (close-up, medium, wide), whether it is a talking-head segment or a product demonstration, and any props or locations required. A 30-second video typically needs 4&ndash;8 distinct shots. Planning these in advance means you can film them efficiently rather than improvising setups between takes.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Prepare your filming environment the day before: charge batteries, test audio, clean your background, set up lighting, and stage any products. When your shoot day arrives, everything should be ready so you can focus entirely on performance. Professional creators often batch-film multiple videos in a single session, which requires even more thorough pre-production planning.</p>
      </div>
    </section>

    <!-- 08 Creator Side: Filming -->
    <section class="guide-section" id="filming">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">08 &mdash; Creator Side</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Filming</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Shoot vertical (9:16) at 1080p minimum &mdash; 4K preferred for reframing flexibility</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Record audio separately or use a lapel mic &mdash; phone mic alone is rarely enough</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Film multiple hook variants and CTA options in every session</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Filming is where preparation meets execution. The two non-negotiable technical requirements are stable, well-lit footage and clean audio. Everything else &mdash; transitions, text overlays, music &mdash; can be added in post. But bad lighting and bad audio cannot be fixed in editing.</p>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Lighting</strong>: Natural light is best for the authentic UGC look. Film facing a window during daytime for soft, even illumination. If natural light is not available, a ring light or two-point softbox setup works. Avoid overhead fluorescent lighting and mixed color temperatures &mdash; they create unflattering shadows and inconsistent skin tones.</p>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Audio</strong>: Audio quality is more important than video quality for engagement. Viewers will watch a slightly grainy video with clear audio, but they will immediately scroll past crisp visuals with echoey, muffled sound. Use a wireless lapel microphone ($20&ndash;$50 for a decent one) clipped inside your collar. Record a test clip and listen with headphones before starting the real takes. Film in a quiet room with soft surfaces &mdash; bedrooms and closets dampen echo better than kitchens and bathrooms.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Camera technique for UGC</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">Shoot vertical (9:16) unless the brief specifies otherwise. Frame yourself from the chest up for talking-head segments, leaving a small margin at the top for platform UI elements. For product demonstrations, alternate between close-ups of the product and medium shots showing you using it. Use a tripod or phone mount for stability &mdash; handheld is acceptable for specific creative choices but not as a default.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Film every hook variant on your list, even if you think the first one was perfect. Film 2&ndash;3 CTA options as well. Record b-roll of the product: packaging, textures, the product in use, lifestyle shots. B-roll takes 5 minutes to film and gives the editor (you or the brand) significantly more flexibility. Brands running <a href="/ugc-video-ads/" class="text-accent hover:underline">UGC video ads</a> especially value extra footage that allows for remix and recut variants.</p>
      </div>
    </section>

    <!-- 09 Creator Side: Editing & Post-Production -->
    <section class="guide-section" id="editing">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">09 &mdash; Creator Side</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Editing &amp; post-production</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Cut aggressively &mdash; every second must earn its place in a 30&ndash;60s video</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Add captions &mdash; 85% of social video is watched without sound</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Export per platform specs: H.264, 9:16, 30fps, under 500MB</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Editing UGC is about pacing, not polish. The goal is to keep viewers watching, not to create cinematic perfection. Cut out every pause, "um," dead space, and unnecessary transition. The best UGC videos feel like a continuous stream of information and energy with zero wasted time. Watch your edit and ask: "Would I keep watching at this exact second?" If the answer is no at any point, cut or replace that section.</p>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Captions</strong> are mandatory, not optional. Approximately 85% of social media video is consumed with the sound off, and auto-generated captions from platforms are unreliable. Use CapCut, Descript, or Premiere Pro to add accurate, well-timed captions. Use a readable font (bold sans-serif, white text with a dark outline or background bar) positioned in the lower third of the frame, away from platform UI elements.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Music, color, and export specs</h3>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Music</strong>: Use royalty-free background music or trending audio from the platform's library. Music should be subtle &mdash; 10&ndash;20% volume relative to speech. It sets the mood without competing with the voiceover. If the brief does not specify music, ask before adding it. <strong>Color correction</strong>: Apply a light color grade to ensure consistent skin tones and exposure across all clips. Do not over-filter &mdash; UGC should look natural, not Instagram-circa-2014.</p>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Export settings by platform</strong>: TikTok and Reels require 9:16 aspect ratio, 1080x1920 minimum, H.264 codec, 30fps, and under 287MB (TikTok) or 250MB (Reels). YouTube Shorts accepts up to 60 seconds at the same specs. If the brand requests assets for paid ads, export at the highest quality available &mdash; ad platforms handle their own compression. Always name files using the convention specified in the brief or default to: <code class="text-[13px] bg-[rgba(99,102,241,.06)] px-1.5 py-0.5 rounded">BrandName_Hook1_CreatorName_Date.mp4</code>.</p>
      </div>
    </section>

    <!-- 10 Creator Side: Delivery & Revisions -->
    <section class="guide-section" id="delivery">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">10 &mdash; Creator Side</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Delivery &amp; revisions</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Use the file naming convention specified in the brief</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Deliver via Google Drive, Dropbox, or WeTransfer &mdash; never DM compressed files</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Handle revision feedback promptly and professionally &mdash; it builds repeat business</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Delivery is the final impression you make as a creator, and first impressions of your professionalism often come from how you deliver. Upload final files to a cloud storage service &mdash; Google Drive, Dropbox, or WeTransfer &mdash; with download permissions enabled. Never send videos via Instagram DM, WhatsApp, or iMessage, as these platforms compress video quality significantly. Organize files in a clear folder structure: one folder per video, containing the edited version, raw footage (if requested), and any alternate cuts.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Follow the file naming convention from the brief. If no convention was specified, use a descriptive format like <code class="text-[13px] bg-[rgba(99,102,241,.06)] px-1.5 py-0.5 rounded">BrandName_VideoType_HookVariant_YourName_YYYYMMDD.mp4</code>. Consistent file naming saves brands significant time when they manage dozens of videos across multiple creators.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Handling revisions</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">When you receive revision feedback, respond within 24 hours &mdash; even if it is just to confirm that you have read it and will deliver the updated version by a specific time. Read all feedback before starting revisions, as individual notes sometimes conflict and you may need clarification. Implement every requested change; if you disagree with a note, explain your reasoning but ultimately defer to the brand unless the request is technically impossible.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Keep raw footage for at least 30 days after delivery. Brands sometimes request re-edits weeks later when they want to test new hooks or CTAs using the same footage. Having the raw files available makes you an easy yes for additional paid work rather than requiring a full reshoot.</p>
      </div>
    </section>

    <!-- 11 Timeline & Milestones -->
    <section class="guide-section" id="timeline">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">11 &mdash; Timeline</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Timeline &amp; milestones</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Standard production cycle: 7&ndash;14 days from brief to final delivery</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Rush timelines (3&ndash;5 days) are possible but typically cost 25&ndash;50% more</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Five milestone checkpoints keep both sides aligned throughout</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">A standard UGC video production cycle runs 7&ndash;14 days from brief delivery to final approved asset. This timeline includes buffer for one round of revisions. Rush timelines of 3&ndash;5 days are feasible for experienced creators with the product already in hand, but they typically come with a 25&ndash;50% premium on the base rate and leave no margin for error.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Five milestone checkpoints</h3>
        <ul class="pl-5 mb-4 space-y-2 text-ink-2">
          <li><strong>Day 1 &mdash; Brief delivered</strong>: Brand sends the brief and any product shipments. Creator confirms receipt, asks clarifying questions, and agrees to the timeline.</li>
          <li><strong>Day 2&ndash;3 &mdash; Script/concept approved</strong>: Creator submits a script or concept outline. Brand reviews and approves, or requests adjustments before filming begins.</li>
          <li><strong>Day 4&ndash;7 &mdash; Raw footage review</strong>: Creator films and submits unedited footage (or a rough assembly). Brand reviews for content accuracy, energy, and brief adherence.</li>
          <li><strong>Day 7&ndash;10 &mdash; First edit delivered</strong>: Creator delivers the edited video with captions, music, and final polish. Brand reviews and provides revision notes.</li>
          <li><strong>Day 10&ndash;14 &mdash; Final delivery</strong>: Creator implements revisions and delivers the final file. Brand approves and the video enters the publishing or ad pipeline.</li>
        </ul>
        <p class="text-ink-2 leading-[1.65] mb-4">Each milestone includes a 24&ndash;48 hour response window for both parties. The most common cause of timeline slippage is not slow filming or editing &mdash; it is delayed feedback from the brand side. Building response-time expectations into the initial agreement prevents the most frequent source of production delays.</p>
      </div>
    </section>

    <!-- 12 Quality Control Checklist -->
    <section class="guide-section" id="qc">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">12 &mdash; Quality Control</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Quality control checklist</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Run every video through this checklist before marking it as approved</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Covers technical specs, content accuracy, brand compliance, and platform readiness</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Use the same checklist on both sides to avoid miscommunication</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Before any video is approved for delivery or publication, run it through a standardized quality control checklist. This applies whether you are the brand reviewing a creator's submission or the creator doing a final self-review before uploading. Using the same checklist on both sides eliminates subjective disagreements about what constitutes "done."</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Technical quality</h3>
        <ul class="pl-5 mb-4 space-y-1.5 text-ink-2">
          <li>Resolution: 1080x1920 minimum (9:16) or as specified in brief</li>
          <li>Audio: speech clearly audible, no background hum or echo, balanced levels (&ndash;6dB to &ndash;3dB peak)</li>
          <li>Lighting: face evenly lit, no harsh shadows, consistent exposure across clips</li>
          <li>Stability: no distracting camera shake (tripod or stabilized footage)</li>
          <li>Duration: within the range specified in the brief (check both minimum and maximum)</li>
          <li>File format: H.264 MP4, file size under platform limits</li>
        </ul>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Content accuracy</h3>
        <ul class="pl-5 mb-4 space-y-1.5 text-ink-2">
          <li>All key messages from the brief are communicated</li>
          <li>Product name pronounced correctly and shown accurately</li>
          <li>No unauthorized claims (health, financial, legal)</li>
          <li>CTA matches the brief's specified action</li>
          <li>Captions are accurate, properly timed, and readable</li>
        </ul>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Brand compliance &amp; platform readiness</h3>
        <ul class="pl-5 mb-4 space-y-1.5 text-ink-2">
          <li>No competitor products or logos visible in frame</li>
          <li>Background is clean and appropriate for the brand</li>
          <li>Music is royalty-free or from the platform's licensed library</li>
          <li>No text or visual elements in the platform safe zones (top 15%, bottom 20%)</li>
          <li>File naming follows the specified convention</li>
          <li>All deliverables included (edited video, raw footage, alternate hooks as applicable)</li>
        </ul>
      </div>
    </section>

    <!-- 13 Glossary -->
    <section class="guide-section" id="glossary">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">13 &mdash; Glossary</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Glossary</h2>
        <ul class="list-none p-0 space-y-3">
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[140px] shrink-0">UGC</strong> User-generated content &mdash; video content created by real people (not the brand's in-house team) for use in marketing and advertising.</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[140px] shrink-0">Brief</strong> A document from the brand that outlines what to create: product details, audience, key messages, format specs, and creative direction.</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[140px] shrink-0">Hook</strong> The first 2&ndash;3 seconds of a video, designed to stop the viewer from scrolling. The highest-leverage element in any UGC ad.</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[140px] shrink-0">CTA</strong> Call to action &mdash; the instruction at the end of the video telling viewers what to do (shop now, learn more, link in bio).</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[140px] shrink-0">B-roll</strong> Supplementary footage (product close-ups, lifestyle shots, textures) used to add visual variety during editing.</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[140px] shrink-0">Raw footage</strong> Unedited video files as captured by the camera, before cutting, color grading, or captioning.</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[140px] shrink-0">Aspect ratio</strong> The width-to-height proportion of the video. 9:16 (vertical) for TikTok, Reels, and Shorts. 1:1 (square) for feed posts. 16:9 (horizontal) for YouTube.</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[140px] shrink-0">Whitelisting</strong> Running paid ads through a creator's social media account rather than the brand's account, for more authentic ad placement.</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[140px] shrink-0">Modular production</strong> Breaking video creation into interchangeable components (hooks, body, CTAs) that can be mixed and matched to create multiple variants.</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[140px] shrink-0">Safe zone</strong> The area of the screen not covered by platform UI elements (profile icons, like buttons, captions). Critical text and faces must stay within the safe zone.</li>
        </ul>
      </div>
    </section>

