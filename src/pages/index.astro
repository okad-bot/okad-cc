---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const cases = [
  {
    title: "High ROAS UGC Ads",
    tags: ["#PAID_ADS", "#DTC", "#E-COM"],
    chips: ["Creative testing", "UGC CONTENT", "UGC video"],
    description: 'Every script follows Multiple Hooks → Body → CTAs structure engineered for watch time and keeps viewers past the 15-second mark through storytelling — not selling.',
    challenge: "The challenge: most UGC ads lose viewers by second 3. We write scripts driving 8%+ view-to-25s retention and measurable ROAS.",
    image: "/images/cases/ugc-ads.gif",
    color: "warm",
  },
  {
    title: "AI static Ads — 3x CTR vs original creo",
    tags: ["#PAID_ADS", "#DTC", "#E-COM"],
    chips: ["UGC content", "Carousels"],
    description: "When parents are choosing a $500+ crib for their newborn, they don't click on flashy banners. They look for something that feels real, safe, and beautiful.",
    challenge: "The challenge: we reworked raw UGC with oversized product into premium visuals that convert.",
    image: "/images/cases/ai-static.png",
    color: "pink",
  },
  {
    title: "UGC Ads & Content by Creators 45+",
    tags: ["#SILVER_AGE", "#DTC", "#E-COM"],
    chips: ["UGC content", "Video", "CAROUSELS"],
    description: "Most agencies use 22-year-old creators and miss mature audiences. We work with 35-55+ creators, focus on trust, and test what actually connects with thoughtful buyers.",
    challenge: "The challenge: match creators to the audience, shift to trust-first messaging, and make content feel relatable.",
    image: "/images/cases/creators45.png",
    color: "green",
  },
  {
    title: "1M views Video-content for Digital",
    tags: ["#ORGANIC", "#DIGITAL", "#DTC"],
    chips: ["UGC video", "UGC CONTENT", "Carousels"],
    description: "Talking-head UGC for products you can't hold in your hands — dating apps, EdTech platforms, AI tools. Each video is built around one 'save-worthy' insight.",
    challenge: "Results: 900K views for a dating app, 990K views + 22K saves for EdTech.",
    image: "/images/cases/1m-views.gif",
    color: "blue",
  },
  {
    title: "High CPA Ads creatives for Digital",
    tags: ["#PAID_ADS", "#DTC", "#DIGITAL"],
    chips: ["UGC video", "UGC CONTENT", "Carousels"],
    description: "Static ad creatives for Meta and TikTok built to convert on cost-per-action. Every card follows a direct-response formula: a bold claim, a pain-point, and one clear CTA.",
    challenge: "The challenge: we design for info products, HR Tech, real estate, investing platforms, and EdTech — where trust is everything and attention is short.",
    image: "/images/cases/high-cpa.png",
    color: "warm",
  },
  {
    title: "UGC & AI-content for Alco Brands",
    tags: ["#ALCO", "#DTC", "#E-COM"],
    chips: ["UGC video", "UGC CONTENT", "Carousels"],
    description: "Alcohol UGC is the hardest content to produce. Your creator needs a full bar setup, fresh ingredients, steady hands for the perfect pour, and a space that looks premium.",
    challenge: "The challenge: we built a creator network specifically for alcohol, combined it with a one-day production shoot with a professional bartender on set.",
    image: "/images/cases/alco.png",
    color: "pink",
  },
];

const designCases = [
  {
    title: "Branding",
    tags: ["#branding", "Design", "CAROUSELS"],
    description: "We built an identity for a Paris trampoline cardio studio where every touchpoint — from the logo to the street signage — carries the same theatrical tension. We turned a trampoline into a personal stage — with drama, shadows, and an aesthetic worthy of a Grand Opera poster.",
    challenge: "The challenge: make a trampoline gym feel like a premium Parisian experience, not a kids' birthday party.",
    image: "/images/design/jumpman.png",
    buttonText: "Explore Jumpman Case",
    color: "green",
  },
  {
    title: "Web Design",
    tags: ["#Webflow", "#Framer", "#Shopify", "Design"],
    description: "Conversion-focused website design for SaaS, HR Tech, and digital products. We structure every page around a single user journey: land, understand, act.",
    challenge: "The challenge: mobile-first, built to load fast and convert on the first visit.",
    image: "/images/design/intalent.png",
    buttonText: "Explore Intalent Case",
    behanceLink: "https://www.behance.net/olga_kad",
    color: "blue",
  },
];

const tiles = [
  { src: "/images/tiles/tile-1.png", alt: "Portfolio work 1" },
  { src: "/images/tiles/tile-2.png", alt: "Portfolio work 2" },
  { src: "/images/tiles/tile-3.png", alt: "Portfolio work 3" },
  { src: "/images/tiles/tile-4.png", alt: "Portfolio work 4" },
  { src: "/images/tiles/tile-5.png", alt: "Portfolio work 5" },
  { src: "/images/tiles/tile-6.png", alt: "Portfolio work 6" },
  { src: "/images/tiles/tile-7.jpg", alt: "Portfolio work 7" },
  { src: "/images/tiles/tile-8.jpg", alt: "Portfolio work 8" },
];

const reviews = [
  {
    text: "Very happy with the video produced by OKAD. It helped us increase our creative output, and communication was smooth throughout.",
    name: "Maxime Lenzlinger",
    role: "Co-founder / Marketing",
    company: "VUE SWISS",
    avatar: "/images/testimonials/maxime.jpg",
  },
  {
    text: "The final result exceeded my expectations. The structure was clear, the content was well-aligned with the brand tone, and every post had a clear purpose and message.",
    name: "Kristina Hr.",
    role: "Marketing",
    company: "Mushroom genetics",
    avatar: "/images/testimonials/kristina.png",
  },
  {
    text: "You're the best team I've ever worked with. You are professional, organized, creative, and kind, and I feel incredibly lucky to have found you.",
    name: "Claire Ginn",
    role: "Founder",
    company: "YPM Agency",
    avatar: "/images/testimonials/claire.png",
  },
  {
    text: "Olga and her team are some of the best designers around. They're creative, work diligently/quickly, and deliver great content.",
    name: "Damon Dixon",
    role: "Founder",
    company: "Douxds",
    avatar: "/images/testimonials/damon.jpg",
  },
];

const videos = [
  {
    title: "High-Converting UGC Video Ad System",
    embedUrl: "https://www.youtube.com/embed/-UTQ0HyGE80?si=hBpETbXfn0ywydfE",
  },
  {
    title: "How to create Static Ads that Actually Convert — 4 Elements every Ad needs",
    embedUrl: "https://www.youtube.com/embed/6ww6ykmc2Pw",
  },
  {
    title: "How We Build Websites That Convert",
    embedUrl: "https://www.youtube.com/embed/UxOC3_DvR2o?start=29",
  },
  {
    title: "Full Branding vs Micro-Branding 6 Real Projects",
    embedUrl: "https://www.youtube.com/embed/njD3orMjpoM?start=3",
  },
];

const stats = [
  { number: "10,000+", label: "Ads & Posts Created" },
  { number: "200+", label: "Websites & Brands Designed" },
];

const tagsRow1 = ["UGC", "AD Creatives", "Carousels", "AI", "CREATOR SOURCING", "#branding"];
const tagsRow2 = ["#web_design", "#Marketing_materials", "Shopify", "Framer", "Digital branding", "packaging branding"];

const blockBg: Record<string, string> = {
  warm: "background: rgba(147,51,234,.04)",
  pink: "background: rgba(236,72,153,.04)",
  green: "background: rgba(16,185,129,.035)",
  blue: "background: rgba(245,166,35,.04)",
};

const pillStyle: Record<string, string> = {
  warm: "background: rgba(147,51,234,.12); color: #9333EA",
  pink: "background: rgba(236,72,153,.12); color: #EC4899",
  green: "background: rgba(16,185,129,.12); color: #10B981",
  blue: "background: rgba(245,166,35,.15); color: #D48B00",
};

const btnBg: Record<string, string> = {
  warm: "#9333EA",
  pink: "#EC4899",
  green: "#10B981",
  blue: "#F5A623",
};
---

<Layout
  title="OKAD Agency — Quality Scroll-Stopping Content At Scale"
  description="Ad creatives, UGC video, marketing assets design. From your first ad to 200+ creatives/month — we scale with you."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="pt-20 md:pt-24">
      <div class="max-w-[1080px] mx-auto px-6 pt-12 md:pt-16 pb-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <div class="inline-flex items-center gap-1.5 font-mono text-[12px] font-medium uppercase tracking-[.06em] text-ink-2 mb-6">
              <strong class="text-accent font-semibold">#PAID_ADS</strong>
              <span class="text-muted-2">·</span>
              <strong class="text-accent font-semibold">#ORGANIC</strong>
              <span class="text-muted-2">·</span>
              <strong class="text-accent font-semibold">#STATIC & VIDEO</strong>
            </div>

            <h1 class="font-display font-bold text-[clamp(36px,6vw,56px)] leading-[1.1] tracking-[-0.035em] mb-6 text-ink">
              Quality<br />
              <span class="font-script text-accent text-[1.1em]">Scroll-Stopping</span><br />
              Content At Scale
            </h1>

            <p class="text-[17px] text-ink-2 leading-[1.55] mb-2">No content? Wrong content?</p>
            <p class="text-[17px] font-semibold text-ink mb-6">&gt; We solve both.</p>

            <div class="flex flex-wrap gap-2 mb-6">
              <span class="inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-[13px] bg-accent-bg border border-accent/15 text-accent font-medium">Boost your sales</span>
              <span class="inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-[13px] bg-accent-bg border border-accent/15 text-accent font-medium">Find new audience</span>
            </div>

            <p class="text-[15px] text-ink-2 leading-[1.55] max-w-[480px] mb-8">
              Ad creatives, UGC video, marketing assets design. From your first ad to 200+ creatives/month — we scale with you.
            </p>

            <div class="flex flex-nowrap gap-2.5">
              <a href="#contact" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full font-sans text-[13px] font-semibold bg-white text-ink border border-[#d1d5db] hover:border-ink hover:bg-ink hover:text-white transition-all no-underline">
                Get a quote →
              </a>
              <a href="https://t.me/o_kad_work" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full font-sans text-[13px] font-semibold bg-lime text-ink hover:bg-[#b8e537] transition-all no-underline">
                Book a call →
              </a>
            </div>
          </div>

          <div class="relative">
            <div class="rounded-3xl overflow-hidden">
              <video autoplay muted loop playsinline poster="/images/hero-poster.jpg" class="w-full aspect-square object-cover">
                <source src="/images/hero-video.mp4" type="video/mp4" />
              </video>
            </div>
            <img src="/images/hero-animation.gif" alt="Creative showcase" class="hidden lg:block absolute -bottom-8 -left-12 w-[320px] rounded-2xl shadow-2xl border-4 border-white" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="py-12 md:py-16">
      <div class="max-w-[1080px] mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-8 mb-10">
          {stats.map((stat) => (
            <div>
              <div class="font-display font-extrabold text-[clamp(40px,6vw,56px)] tracking-[-0.03em] text-ink">{stat.number}</div>
              <div class="text-[17px] text-muted mt-1">{stat.label}</div>
            </div>
          ))}
        </div>

        <div class="space-y-3">
          <div class="flex flex-wrap gap-2.5 justify-center">
            {tagsRow1.map((tag) => (
              <span class="px-4 py-2 text-[11px] font-semibold uppercase tracking-[.08em] bg-card rounded-full text-ink-2 border border-border">{tag}</span>
            ))}
          </div>
          <div class="flex flex-wrap gap-2.5 justify-center">
            {tagsRow2.map((tag) => (
              <span class="px-4 py-2 text-[11px] font-semibold uppercase tracking-[.08em] bg-card rounded-full text-ink-2 border border-border">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Content Cases -->
    <section id="content" class="py-16 md:py-20">
      <div class="max-w-[1080px] mx-auto px-6">
        <p class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-3 text-center">Content</p>
        <h2 class="font-display font-bold text-[clamp(28px,4vw,40px)] leading-[1.1] tracking-[-0.03em] text-center mb-12">
          Explore Our Content Cases
        </h2>

        <div class="space-y-6">
          {cases.map((c) => (
            <div class="rounded-3xl p-8 md:p-10 shadow-[inset_0_1px_0_rgba(255,255,255,.6)]" style={blockBg[c.color]}>
              <div class="grid lg:grid-cols-2 gap-8 items-center">
                <div>
                  <div class="flex flex-wrap gap-2 mb-4">
                    {c.tags.map((tag) => (
                      <span class="rounded-full px-3 py-1 font-mono text-[11px] font-semibold uppercase tracking-[.08em]" style={pillStyle[c.color]}>{tag}</span>
                    ))}
                  </div>
                  <h3 class="font-display font-extrabold text-[clamp(22px,3vw,28px)] leading-[1.15] tracking-[-0.03em] mb-4 text-ink">{c.title}</h3>
                  <div class="flex flex-wrap gap-2 mb-5">
                    {c.chips.map((chip) => (
                      <span class="px-3 py-1.5 text-[12px] font-medium bg-white/80 rounded-full text-ink-2 border border-border">{chip}</span>
                    ))}
                  </div>
                  <p class="text-[15px] text-ink-2 leading-[1.55] mb-3">{c.description}</p>
                  <p class="text-[13px] text-muted italic mb-6">{c.challenge}</p>
                  <div class="flex flex-wrap gap-2.5">
                    <a href="#contact" class="inline-flex items-center gap-1.5 px-[18px] py-2.5 rounded-full font-sans text-[13px] font-semibold text-white no-underline transition-all" style={`background: ${btnBg[c.color]}`}>
                      Explore Case →
                    </a>
                    <a href="#contact" class="inline-flex items-center gap-1.5 px-[18px] py-2.5 rounded-full font-sans text-[13px] font-semibold bg-white text-ink border border-[#d1d5db] hover:border-ink transition-all no-underline">
                      Get a quote
                    </a>
                  </div>
                </div>
                <div class="rounded-2xl overflow-hidden">
                  <img src={c.image} alt={c.title} class="w-full h-auto object-cover rounded-2xl" loading="lazy" />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Design Cases -->
    <section id="design" class="py-16 md:py-20 bg-card border-t border-b border-border">
      <div class="max-w-[1080px] mx-auto px-6">
        <p class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-3 text-center">Design</p>
        <h2 class="font-display font-bold text-[clamp(28px,4vw,40px)] leading-[1.1] tracking-[-0.03em] text-center mb-12">
          Explore Design Cases
        </h2>

        <div class="space-y-6">
          {designCases.map((c) => (
            <div class="rounded-3xl p-8 md:p-10 shadow-[inset_0_1px_0_rgba(255,255,255,.6)]" style={blockBg[c.color]}>
              <div class="grid lg:grid-cols-2 gap-8 items-center">
                <div>
                  <div class="flex flex-wrap gap-2 mb-4">
                    {c.tags.map((tag) => (
                      <span class="rounded-full px-3 py-1 font-mono text-[11px] font-semibold uppercase tracking-[.08em]" style={pillStyle[c.color]}>{tag}</span>
                    ))}
                  </div>
                  <h3 class="font-display font-extrabold text-[clamp(22px,3vw,28px)] leading-[1.15] tracking-[-0.03em] mb-4 text-ink">{c.title}</h3>
                  <p class="text-[15px] text-ink-2 leading-[1.55] mb-3">{c.description}</p>
                  <p class="text-[13px] text-muted italic mb-6">{c.challenge}</p>
                  <div class="flex flex-wrap gap-2.5">
                    <a href="#" class="inline-flex items-center gap-1.5 px-[18px] py-2.5 rounded-full font-sans text-[13px] font-semibold text-white no-underline transition-all" style={`background: ${btnBg[c.color]}`}>
                      {c.buttonText} →
                    </a>
                    <a href="#contact" class="inline-flex items-center gap-1.5 px-[18px] py-2.5 rounded-full font-sans text-[13px] font-semibold bg-white text-ink border border-[#d1d5db] hover:border-ink transition-all no-underline">
                      Get a quote
                    </a>
                  </div>
                  {c.behanceLink && (
                    <a href={c.behanceLink} target="_blank" rel="noopener noreferrer" class="inline-block mt-5 text-[13px] font-medium text-accent hover:underline no-underline">
                      Explore More Design Cases on Behance →
                    </a>
                  )}
                </div>
                <div class="rounded-2xl overflow-hidden">
                  <img src={c.image} alt={c.title} class="w-full h-auto object-cover rounded-2xl" loading="lazy" />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Portfolio Grid -->
    <section class="py-16 md:py-20">
      <div class="max-w-[1080px] mx-auto px-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {tiles.map((tile, i) => (
            <div class:list={[
              "rounded-2xl overflow-hidden",
              (i === 2 || i === 3 || i === 6 || i === 7) ? "md:col-span-2" : "",
            ]}>
              <img src={tile.src} alt={tile.alt} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Videos -->
    <section id="video" class="py-16 md:py-20 bg-card border-t border-b border-border">
      <div class="max-w-[1080px] mx-auto px-6">
        <div class="text-center mb-10">
          <p class="text-[17px] text-muted mb-2">Not ready for a call?</p>
          <h2 class="font-display font-bold text-[clamp(28px,4vw,40px)] leading-[1.1] tracking-[-0.03em]">
            Watch me walk through real projects
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-5">
          {videos.map((video) => (
            <div class="bg-bg rounded-2xl overflow-hidden border border-border">
              <div class="aspect-video">
                <iframe src={video.embedUrl} title={video.title} class="w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy" />
              </div>
              <div class="p-4">
                <p class="text-[13px] font-semibold text-ink-2">{video.title}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="py-16 md:py-20">
      <div class="max-w-[1080px] mx-auto px-6">
        <h2 class="font-display font-bold text-[clamp(28px,4vw,40px)] leading-[1.1] tracking-[-0.03em] mb-3">
          Don't take our word for it
        </h2>
        <p class="text-[17px] text-muted max-w-[480px] mb-10 leading-[1.55]">
          Ad creatives, websites, and brand systems for 100+ brands. From first concept to scaled production.
        </p>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
          {reviews.map((review) => (
            <div class="bg-card border border-border rounded-2xl p-6 flex flex-col">
              <div class="text-[#F59E0B] text-[14px] mb-2.5">★★★★★</div>
              <p class="text-[15px] text-ink-2 leading-[1.55] italic flex-1 mb-5">
                "{review.text}"
              </p>
              <div class="flex items-center gap-2.5 mt-auto">
                <img src={review.avatar} alt={review.name} class="w-9 h-9 rounded-full object-cover" loading="lazy" />
                <div>
                  <div class="text-[14px] font-semibold text-ink">{review.name}</div>
                  <div class="text-[12px] text-muted">{review.role} of {review.company}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact / Founder CTA -->
    <section id="contact" class="bg-dark py-16 md:py-20">
      <div class="max-w-[1080px] mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-5">
          <div class="bg-white/8 border border-white/10 rounded-2xl p-8 md:p-10 transition-transform hover:-translate-y-0.5">
            <h2 class="font-display font-bold text-[clamp(24px,4vw,32px)] tracking-[-0.02em] text-white mb-4">
              Start with a Conversation
            </h2>
            <p class="text-[17px] text-white/60 leading-[1.55] mb-8">
              I'm Olga, founder of OKAD. Most projects start with a quick 20-min call to understand your brand and share relevant cases.
            </p>
            <div class="space-y-2.5 mb-8">
              <p class="text-[13px] text-white/40">Founder: Olga Kad Miller</p>
              <p class="text-[13px] text-white/40">Email: <a href="mailto:olga@okad.agency" class="text-white hover:text-accent transition-colors no-underline">olga@okad.agency</a></p>
              <p class="text-[13px] text-white/40">WhatsApp: <a href="https://wa.me/351939209099" class="text-white hover:text-accent transition-colors no-underline">+351 939 209 099</a></p>
            </div>
            <div class="flex flex-wrap gap-2.5">
              <a href="mailto:olga@okad.agency" class="inline-flex items-center px-5 py-2.5 bg-white text-ink text-[13px] font-semibold rounded-full hover:bg-border transition-colors no-underline">Email Us</a>
              <a href="https://wa.me/351939209099" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 bg-lime text-ink text-[13px] font-semibold rounded-full hover:bg-[#b8e537] transition-colors no-underline">WhatsApp</a>
              <a href="https://www.linkedin.com/in/o-kad/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 text-white/60 text-[13px] font-semibold rounded-full border border-white/15 hover:text-white hover:border-white/40 transition-colors no-underline">LinkedIn</a>
            </div>
          </div>

          <div class="bg-white/8 border border-white/10 rounded-2xl p-8 md:p-10 transition-transform hover:-translate-y-0.5 flex items-center justify-center">
            <img src="/images/founder.png" alt="Olga Kad Miller, founder of OKAD Agency" class="w-64 md:w-72 rounded-2xl" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
