---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const stats = [
  { num: "150+", desc: "creatives tested per client" },
  { num: "32%", desc: "winner hit rate" },
  { num: "$26", desc: "best cost per customer" },
  { num: "600+", desc: "creators in our network" },
];

const showcases = [
  { tag: "#paid_ads", title: "High ROAS UGC Ads", desc: "71 videos, 14 winners. Best CPA $26 against $70 target. Modular scripts with 3+ hooks per concept.", img: "https://framerusercontent.com/images/BmUk0KMAPqqpLzpARwDdXhfg.gif" },
  { tag: "#paid_ads", title: "AI Static Ads — 3x CTR", desc: "AI-generated statics brought customers at half the cost of traditional creatives.", img: "https://framerusercontent.com/images/j1iBjvbPI3bC6gVlOIvjMvQ0Oos.png" },
  { tag: "#silver_age", title: "UGC Ads by Creators 45+", desc: "Underserved demographic, higher trust. Outperformed younger creators on health & wellness products.", img: "https://framerusercontent.com/images/FXMkq1jH116yCF0nIQPl2N2vc.png" },
  { tag: "#organic", title: "1M Views Video Content", desc: "Organic content for digital brands. Same production pipeline, optimized for engagement instead of conversions.", img: "https://framerusercontent.com/images/fgyKKr3g1dPjydOItu6UTCo3k8.gif" },
  { tag: "#paid_ads", title: "High CPA Ads for Digital", desc: "Voiceover + B-roll format brought 25% lower CPA than talking heads across all creatives.", img: "https://framerusercontent.com/images/WpH2ghvnLZkT7E1Ekkky6uTuFg.png" },
  { tag: "#alco", title: "UGC & AI for Alco Brands", desc: "Regulated category, restricted placements. AI statics + UGC with compliance-safe scripts.", img: "https://framerusercontent.com/images/SBAkW2rwVUXKWpG9XA9enjK968.png" },
];

const compareBefore = [
  "Hire a videographer or agency for 5-10 videos",
  "Pick the \"best\" creative based on gut feeling",
  "Run it until it burns out",
  "Start from scratch next month",
  "No data on what actually worked or why",
];

const compareAfter = [
  "40-70 videos per batch, each testing one idea",
  "Modular scripts: 3 hooks × 2 creators × 2 formats = 12 videos from one concept",
  "Real purchase data after 2-3 weeks",
  "Scale winners, kill losers, iterate the middle",
  "You know exactly what worked and why",
];

const steps = [
  { title: "Research & hypotheses", desc: "We analyze your competitors' ads, your existing data, customer reviews. We build 5-8 testing angles — real pain points your customers have." },
  { title: "Scripts & creators", desc: "Modular scripts: one proven body, multiple openings. We match 2-3 creators from our 600+ network to each concept based on product fit." },
  { title: "Production & launch", desc: "Creators shoot, we edit, first batch goes live as ads. 40-70 videos in 2 weeks. UGC, voiceover + B-roll, AI statics, product demos.", highlight: "40-70 videos in 2 weeks" },
  { title: "Data & decisions", desc: "After 2-3 weeks of ad data, we tag every creative: Scale, Iterate, or Kill. Not likes — actual purchases. Then we scale winners and test new ideas.", highlight: "Decisions from purchase data, not guesswork" },
];

const batchContent = [
  { color: "warm", tag: "Angles", title: "5-8 reasons people buy your product", desc: "Real pain points, not marketing guesses. For supplements: bloating, fatigue, sleep. For AI products: speed, social proof, before/after. Each angle is a testing track." },
  { color: "pink", tag: "Scripts", title: "Modular: hook + body + CTA", desc: "3+ openings per concept. Written from research — competitor ads, customer surveys, your ad data. Scripts are the core of what we deliver." },
  { color: "blue", tag: "Creators", title: "The person matters more than the script", desc: "Same script can cost $32/customer with one creator and $92 with another. We test 2-3 creators per batch from our 600+ network to find the best fit." },
  { color: "green", tag: "Formats", title: "6 formats, tested — not assumed", desc: "UGC talking head, voiceover + B-roll, before/after, product demo, POV, AI statics. In our data, VO + B-roll costs 25% less per customer than talking heads." },
];

const resultRows = [
  { name: "15MinStart", angle: "Speed", format: "UGC", cpa: "$26", customers: "4", spend: "$106", action: "Scale", actionColor: "bg-ok-bg text-ok" },
  { name: "RecruitersNotice", angle: "Pain", format: "VO + B-roll", cpa: "$32", customers: "16", spend: "$506", action: "Scale", actionColor: "bg-ok-bg text-ok" },
  { name: "WorstToBest", angle: "Before/After", format: "UGC", cpa: "$40", customers: "93", spend: "$3,684", action: "Scale", actionColor: "bg-ok-bg text-ok" },
  { name: "ViewsTripled", angle: "Social Proof", format: "UGC", cpa: "$47", customers: "23", spend: "$1,082", action: "Scale", actionColor: "bg-ok-bg text-ok" },
  { name: "LinkedInMakeover", angle: "Aspiration", format: "VO + B-roll", cpa: "$73", customers: "8", spend: "$584", action: "Iterate", actionColor: "bg-[#fff8e1] text-[#f57f17]" },
  { name: "NoMoreAwkward", angle: "Pain", format: "UGC", cpa: "$82", customers: "5", spend: "$410", action: "Iterate", actionColor: "bg-[#fff8e1] text-[#f57f17]" },
  { name: "CareerCredibility", angle: "Career", format: "UGC", cpa: "$116", customers: "3", spend: "$348", action: "Kill", actionColor: "bg-[#fce4ec] text-[#c62828]" },
];

const batches = [
  { num: "Batch 1", title: "Find what works", items: ["40-70 original videos", "Multiple angles, creators, formats", "Every video = a hypothesis", "Clear pass/fail after 2-3 weeks of ad data"] },
  { num: "Batch 2", title: "Scale the winners", items: ["10+ variations of every Batch 1 winner", "New hooks, re-edited middles, different CTAs", "Budget follows performance, not volume"] },
  { num: "Batch 3", title: "Find more", items: ["50 new concepts, untested ideas", "New pain points, audiences, formats", "Runs in parallel with Batch 2"] },
];

const timeline = [
  { label: "Week 1-2", desc: "Research competitors' ads, analyze your data, build testing hypotheses, write all scripts." },
  { label: "Week 3-4", desc: "Creators shoot. We edit. First batch goes live as ads." },
  { label: "Week 5-6", desc: "Purchase data comes in. Tag every creative: Scale, Iterate, Kill. Start producing variations of winners." },
  { label: "Month 2", desc: "Batch 2 scales winners. Batch 3 tests new ideas. You have 100-150 tested creatives and a scaling playbook." },
];

const pricingPlans = [
  { name: "Launch", price: "$2,650", period: "per month", desc: "Test the approach before committing to scale.", features: ["15 videos", "1 creator", "3-4 angles", "Modular scripts", "Results dashboard"], color: "green" },
  { name: "Growth", price: "$3,450", period: "per month", desc: "Full creative testing with creator-fit analysis.", features: ["20 videos", "2 creators", "5-6 angles", "Modular scripts", "Creator-angle fit analysis", "AI statics included"], color: "warm" },
  { name: "Scale", price: "$5,050", period: "per month", desc: "For teams spending $100K+/month on ads.", features: ["30+ videos", "2-3 creators", "6-8 angles", "Modular scripts", "Full format testing", "AI statics + video", "Weekly reporting"], color: "dark" },
];

const blockBg: Record<string, string> = {
  warm: "background: rgba(147,51,234,.04)",
  pink: "background: rgba(236,72,153,.04)",
  green: "background: rgba(16,185,129,.035)",
  blue: "background: rgba(245,166,35,.04)",
};

const pillStyle: Record<string, string> = {
  warm: "background: rgba(147,51,234,.12); color: #9333EA",
  pink: "background: rgba(236,72,153,.12); color: #EC4899",
  green: "background: rgba(16,185,129,.12); color: #10B981",
  blue: "background: rgba(245,166,35,.15); color: #D48B00",
};

const emailHref = "mailto:olga@okad.agency?subject=Creative%20testing%20%E2%80%94%20tell%20us%20about%20your%20product";
const calHref = "https://calendly.com/okad_calls/first";
---

<Layout
  title="Creative Testing — OKAD Agency"
  description="We make video ads and find which ones actually work. 40-70 creatives per batch with real UGC creators and AI."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="pt-16 md:pt-20 pb-0 bg-bg">
      <div class="max-w-[1100px] mx-auto px-6">
        <div class="text-center py-6 md:py-16">
          <div class="flex flex-wrap justify-center gap-2 mb-4 md:mb-6">
            <span class="font-mono text-[10px] md:text-[11px] font-semibold uppercase tracking-[.06em] px-2.5 py-0.5 rounded-full" style="background: rgba(16,185,129,.12); color: #10B981">#creative_testing</span>
            <span class="font-mono text-[10px] md:text-[11px] font-semibold uppercase tracking-[.06em] px-2.5 py-0.5 rounded-full bg-card border border-border text-ink-2">#paid_ads</span>
            <span class="font-mono text-[10px] md:text-[11px] font-semibold uppercase tracking-[.06em] px-2.5 py-0.5 rounded-full bg-card border border-border text-ink-2">#viral_content</span>
          </div>
          <h1 class="font-display font-medium text-[clamp(26px,5vw,52px)] leading-[1.1] tracking-[-0.04em] text-ink mb-3 md:mb-5">
            We make video ads<br>and find which ones<br><span class="font-script text-accent">actually work</span>
          </h1>
          <p class="text-[14px] md:text-[16px] leading-[1.5] text-ink-2 max-w-[520px] mx-auto mb-4 md:mb-8">
            Creative testing for DTC and tech brands.<br class="md:hidden" />
            50+ creatives / mo, real UGC creators + AI.<br class="md:hidden" />
            Your CPA goes down, winning creatives multiply.
          </p>
          <div class="flex flex-nowrap justify-center gap-2.5 mb-6 md:mb-12">
            <a href={emailHref} class="inline-flex items-center px-5 py-2.5 rounded-full font-sans text-[14px] md:text-[15px] font-medium bg-lime text-ink hover:bg-[#b8e537] transition-all no-underline whitespace-nowrap">Get started</a>
            <a href="#how" class="inline-flex items-center px-5 py-2.5 rounded-full font-sans text-[14px] md:text-[15px] font-medium bg-card text-ink-2 border border-border hover:border-ink hover:text-ink transition-all no-underline whitespace-nowrap">How it works ↓</a>
          </div>
          <div class="max-w-[600px] mx-auto">
            <img src="https://framerusercontent.com/images/BmUk0KMAPqqpLzpARwDdXhfg.gif" alt="UGC Ad Example" class="w-full rounded-3xl shadow-[0_8px_40px_rgba(0,0,0,.08)]" />
          </div>
        </div>
      </div>
    </section>

    <!-- Trust strip -->
    <div class="max-w-[1000px] mx-auto px-6 py-8 text-center">
      <div class="font-mono text-[12px] uppercase tracking-[1.5px] text-muted mb-4">Trusted by</div>
      <div class="flex justify-center items-center gap-10 flex-wrap">
        {["VUE SWISS", "Douxds", "YPM Agency", "Mushroom Genetics", "InstaHeadshots"].map((name) => (
          <span class="font-display font-semibold text-[15px] tracking-[-0.3px] text-ink-2 opacity-50">{name}</span>
        ))}
      </div>
    </div>

    <!-- Stats -->
    <div class="max-w-[1000px] mx-auto px-6 py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map((s) => (
          <div class="text-center">
            <div class="font-display font-semibold text-[clamp(28px,3vw,40px)] tracking-[-1px] text-ink">{s.num}</div>
            <div class="text-[13px] text-muted mt-1 leading-[1.4]">{s.desc}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="max-w-[1000px] mx-auto px-6"><hr class="border-border" /></div>

    <!-- Work / Showcase -->
    <section id="work" class="max-w-[1000px] mx-auto px-6 py-16">
      <h2 class="font-display font-medium text-[clamp(26px,3vw,36px)] leading-[1.2] tracking-[-0.03em] text-ink mb-5">
        Our <span class="font-script text-accent">work</span>
      </h2>
      <p class="text-[16px] leading-[1.65] text-ink-2 max-w-[680px] mb-8">UGC ads, AI statics, creator content, video production — here's what we make for brands like yours.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {showcases.map((s) => (
          <div class="rounded-3xl overflow-hidden relative aspect-[4/3] group cursor-pointer">
            <img src={s.img} alt={s.title} class="w-full h-full object-cover group-hover:scale-[1.01] transition-transform duration-300" loading="lazy" />
            <div class="absolute bottom-0 left-0 right-0 p-6 bg-gradient-to-t from-black/75 to-transparent">
              <div class="font-mono text-[10px] font-semibold uppercase tracking-[1.5px] text-lime mb-1.5">{s.tag}</div>
              <h3 class="font-display font-medium text-[18px] tracking-[-0.5px] text-white leading-[1.25] mb-1">{s.title}</h3>
              <p class="text-[13px] text-white/70 leading-[1.45]">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="max-w-[1000px] mx-auto px-6"><hr class="border-border" /></div>

    <!-- How it works -->
    <section id="how" class="max-w-[1000px] mx-auto px-6 py-16">
      <h2 class="font-display font-medium text-[clamp(26px,3vw,36px)] leading-[1.2] tracking-[-0.03em] text-ink mb-5">
        How <span class="font-script text-accent">it works</span>
      </h2>
      <p class="text-[16px] leading-[1.65] text-ink-2 max-w-[680px] mb-8">Most teams test 5-10 video ads per month. That's not enough data to find patterns. Here's what we do differently.</p>

      <!-- Comparison -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        <div class="rounded-3xl p-7 bg-bg border border-border">
          <div class="font-mono text-[11px] font-semibold uppercase tracking-[1.5px] text-muted mb-4">How most brands do it</div>
          <ul class="list-none p-0 m-0 space-y-1.5">
            {compareBefore.map((item) => (
              <li class="text-[14px] leading-[1.55] text-ink-2 pl-5 relative">
                <span class="absolute left-0 text-muted text-[13px]">—</span>{item}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-3xl p-7" style="background: rgba(16,185,129,.035); border: 1px solid #10B981">
          <div class="font-mono text-[11px] font-semibold uppercase tracking-[1.5px] text-green-text mb-4">Our approach</div>
          <ul class="list-none p-0 m-0 space-y-1.5">
            {compareAfter.map((item) => (
              <li class="text-[14px] leading-[1.55] text-ink-2 pl-5 relative">
                <span class="absolute left-0 text-green-text text-[13px]">✓</span>{item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Steps -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {steps.map((step, i) => (
          <div class="bg-card border border-border rounded-3xl p-7">
            <div class="font-mono text-[12px] font-semibold text-green-text uppercase tracking-[1px] mb-3">Step {i + 1}</div>
            <h3 class="font-display font-medium text-[18px] tracking-[-0.3px] text-ink mb-2 leading-[1.3]">{step.title}</h3>
            <p class="text-[14px] leading-[1.55] text-ink-2 mb-0">{step.desc}</p>
            {step.highlight && <div class="font-display font-medium text-[13px] text-green-text mt-3">{step.highlight}</div>}
          </div>
        ))}
      </div>
    </section>

    <!-- Mid-page CTA -->
    <div class="max-w-[1000px] mx-auto px-6 py-8 text-center">
      <p class="text-[16px] text-ink-2 max-w-[480px] mx-auto leading-[1.6] mb-5">Have a product and wondering what we'd test? Describe your situation — we'll think about it and suggest next steps.</p>
      <a href={emailHref} class="inline-flex items-center px-5 py-2.5 rounded-full font-sans text-[15px] font-medium bg-lime text-ink hover:bg-[#b8e537] transition-all no-underline">Write to us</a>
    </div>

    <div class="max-w-[1000px] mx-auto px-6"><hr class="border-border" /></div>

    <!-- What's inside -->
    <section id="batch" class="max-w-[1000px] mx-auto px-6 py-16">
      <h2 class="font-display font-medium text-[clamp(26px,3vw,36px)] leading-[1.2] tracking-[-0.03em] text-ink mb-5">
        What's inside <span class="font-script text-accent">each batch</span>
      </h2>
      <p class="text-[16px] leading-[1.65] text-ink-2 max-w-[680px] mb-8">Everything you need to go from zero to tested at scale.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {batchContent.map((b) => (
          <div class="rounded-3xl p-7 shadow-[inset_0_1px_0_rgba(255,255,255,.6)]" style={blockBg[b.color]}>
            <div class="font-mono text-[11px] font-semibold uppercase tracking-[1.5px] mb-3" style={pillStyle[b.color].split(';')[1]}>{b.tag}</div>
            <h3 class="font-display font-medium text-[20px] tracking-[-0.5px] text-ink mb-2.5 leading-[1.25]">{b.title}</h3>
            <p class="text-[14px] leading-[1.55] text-ink-2">{b.desc}</p>
          </div>
        ))}
      </div>
      <div class="mt-4 rounded-3xl p-7 shadow-[inset_0_1px_0_rgba(255,255,255,.6)]" style="background: rgba(245,166,35,.04)">
        <div class="font-mono text-[11px] font-semibold uppercase tracking-[1.5px] mb-3" style="color: #D48B00">AI visuals</div>
        <h3 class="font-display font-medium text-[20px] tracking-[-0.5px] text-ink mb-2.5 leading-[1.25]">AI-generated scenes and statics at half the cost</h3>
        <p class="text-[14px] leading-[1.55] text-ink-2">AI statics brought customers at half the cost of traditional statics. Combined with UGC and scripts — AI handles visual variety while creators handle trust.</p>
      </div>
    </section>

    <div class="max-w-[1000px] mx-auto px-6"><hr class="border-border" /></div>

    <!-- Results -->
    <section id="results" class="max-w-[1000px] mx-auto px-6 py-16">
      <h2 class="font-display font-medium text-[clamp(26px,3vw,36px)] leading-[1.2] tracking-[-0.03em] text-ink mb-5">
        What a real <span class="font-script text-accent">results table</span> looks like
      </h2>
      <p class="text-[16px] leading-[1.65] text-ink-2 max-w-[680px] mb-8">From an actual first batch for an AI product. Every creative is tagged with what it tested and what happened.</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="bg-card border border-border rounded-2xl p-6 text-center">
          <div class="font-display font-semibold text-[28px] tracking-[-1px] text-ink">$26</div>
          <div class="text-[13px] text-muted mt-1 leading-[1.4]">best CPA<br>(target was $70)</div>
        </div>
        <div class="bg-card border border-border rounded-2xl p-6 text-center">
          <div class="font-display font-semibold text-[28px] tracking-[-1px] text-ink">32%</div>
          <div class="text-[13px] text-muted mt-1 leading-[1.4]">winner hit rate<br>(14 out of 44)</div>
        </div>
        <div class="bg-card border border-border rounded-2xl p-6 text-center">
          <div class="font-display font-semibold text-[28px] tracking-[-1px] text-ink">3x</div>
          <div class="text-[13px] text-muted mt-1 leading-[1.4]">cost difference<br>same script, different creator</div>
        </div>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-border bg-card">
        <table class="w-full border-collapse text-[14px]">
          <thead class="bg-bg">
            <tr>
              {["Creative", "Angle", "Format", "Cost / customer", "Customers", "Ad spend", "Action"].map((h) => (
                <th class="font-display font-medium text-[11px] uppercase tracking-[.8px] text-muted px-4 py-3.5 text-left whitespace-nowrap">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {resultRows.map((r) => (
              <tr class="border-t border-bg">
                <td class="px-4 py-3.5 whitespace-nowrap font-medium text-ink">{r.name}</td>
                <td class="px-4 py-3.5 whitespace-nowrap text-ink-2">{r.angle}</td>
                <td class="px-4 py-3.5 whitespace-nowrap text-ink-2">{r.format}</td>
                <td class="px-4 py-3.5 whitespace-nowrap text-ink-2">{r.cpa}</td>
                <td class="px-4 py-3.5 whitespace-nowrap text-ink-2">{r.customers}</td>
                <td class="px-4 py-3.5 whitespace-nowrap text-ink-2">{r.spend}</td>
                <td class="px-4 py-3.5 whitespace-nowrap"><span class={`inline-block text-[11px] font-medium px-2.5 py-0.5 rounded-full ${r.actionColor}`}>{r.action}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-[14px] text-muted mt-4">71 videos produced. 44 launched. 14 winners. The $30 median CPM was stable across all creatives — every cost difference came from the creative itself.</p>
    </section>

    <!-- Mid-page CTA -->
    <div class="max-w-[1000px] mx-auto px-6 py-8 text-center">
      <p class="text-[16px] text-ink-2 max-w-[480px] mx-auto leading-[1.6] mb-5">Want to see what a batch would look like for your product?</p>
      <div class="flex flex-wrap justify-center gap-2.5">
        <a href={emailHref} class="inline-flex items-center px-5 py-2.5 rounded-full font-sans text-[15px] font-medium bg-lime text-ink hover:bg-[#b8e537] transition-all no-underline">Tell us about your product</a>
        <a href={calHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 rounded-full font-sans text-[15px] font-medium bg-card text-ink-2 border border-border hover:border-ink hover:text-ink transition-all no-underline">Or book a call</a>
      </div>
    </div>

    <div class="max-w-[1000px] mx-auto px-6"><hr class="border-border" /></div>

    <!-- Process: 3 batches -->
    <section id="process" class="max-w-[1000px] mx-auto px-6 py-16">
      <h2 class="font-display font-medium text-[clamp(26px,3vw,36px)] leading-[1.2] tracking-[-0.03em] text-ink mb-5">
        Three batches, <span class="font-script text-accent">two months</span>
      </h2>
      <p class="text-[16px] leading-[1.65] text-ink-2 max-w-[680px] mb-8">By the end of month 2: 100-150 tested creatives, a clear picture of what works, and a system to keep finding winners.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {batches.map((b) => (
          <div class="bg-card border border-border rounded-3xl p-7">
            <div class="font-mono text-[11px] font-semibold text-green-text uppercase tracking-[1.5px] mb-3">{b.num}</div>
            <h3 class="font-display font-medium text-[20px] tracking-[-0.5px] text-ink mb-2.5">{b.title}</h3>
            <ul class="list-none p-0 m-0 space-y-1">
              {b.items.map((item) => (
                <li class="text-[14px] leading-[1.55] text-ink-2 pl-5 relative">
                  <span class="absolute left-0 text-green-text text-[13px]">→</span>{item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <div class="max-w-[1000px] mx-auto px-6"><hr class="border-border" /></div>

    <!-- Timeline -->
    <section class="max-w-[1000px] mx-auto px-6 py-16">
      <h2 class="font-display font-medium text-[clamp(26px,3vw,36px)] leading-[1.2] tracking-[-0.03em] text-ink mb-8">Timeline</h2>
      <div>
        {timeline.map((t) => (
          <div class="grid grid-cols-[100px_1fr] gap-6 py-5 border-t border-border">
            <div class="font-display font-medium text-[14px] text-green-text">{t.label}</div>
            <div class="text-[15px] leading-[1.55] text-ink-2">{t.desc}</div>
          </div>
        ))}
      </div>
    </section>

    <div class="max-w-[1000px] mx-auto px-6"><hr class="border-border" /></div>

    <!-- Pricing -->
    <section id="pricing" class="max-w-[1000px] mx-auto px-6 py-16">
      <h2 class="font-display font-medium text-[clamp(26px,3vw,36px)] leading-[1.2] tracking-[-0.03em] text-ink mb-5">Pricing</h2>
      <p class="text-[16px] leading-[1.65] text-ink-2 max-w-[680px] mb-8">A full-time videographer costs $4-5K/month and produces 10-15 videos. We deliver 40-70 with strategy, scripts, creators, editing, and a results dashboard.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {pricingPlans.map((plan) => (
          <div class={`rounded-3xl p-8 flex flex-col ${plan.color === 'dark' ? 'bg-dark text-muted' : ''}`} style={plan.color !== 'dark' ? blockBg[plan.color] : ''}>
            <div class={`font-mono text-[11px] font-semibold uppercase tracking-[1.5px] mb-3 ${plan.color === 'dark' ? 'text-lime' : ''}`} style={plan.color !== 'dark' ? pillStyle[plan.color].split(';')[1] : ''}>{plan.name}</div>
            <div class={`font-display font-medium text-[32px] tracking-[-1px] mb-1 ${plan.color === 'dark' ? 'text-white' : 'text-ink'}`}>{plan.price}</div>
            <div class="text-[13px] opacity-60 mb-4">{plan.period}</div>
            <p class="text-[14px] leading-[1.55] mb-4">{plan.desc}</p>
            <ul class="list-none p-0 m-0 space-y-1 mt-auto">
              {plan.features.map((f) => (
                <li class="text-[13px] leading-[1.5] pl-5 relative">
                  <span class={`absolute left-0 text-[12px] ${plan.color === 'dark' ? 'text-lime' : 'text-green-text'}`}>✓</span>{f}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="text-[14px] text-muted mt-6">Already have creators or scripts? We can work with what you have. Write to us and we'll figure out the right setup.</p>
    </section>

    <!-- Final CTA -->
    <section id="contact" class="max-w-[1000px] mx-auto px-6 pb-20">
      <div class="bg-dark rounded-3xl p-12 md:p-16 text-center">
        <h2 class="font-display font-medium text-[clamp(28px,3.5vw,44px)] tracking-[-0.03em] leading-[1.15] text-white mb-4">
          Want to see if this works<br><span class="font-script">for your product?</span>
        </h2>
        <p class="text-[16px] text-muted max-w-[480px] mx-auto leading-[1.6] mb-8">Write to us about your product and current situation. We'll review it, think about what we'd test, and suggest next steps. No commitment needed.</p>
        <div class="flex flex-wrap justify-center gap-2.5 mb-8">
          <a href={emailHref} class="inline-flex items-center px-5 py-2.5 rounded-full font-sans text-[15px] font-medium bg-lime text-ink hover:bg-[#b8e537] transition-all no-underline">Tell us about your product</a>
          <a href={calHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 rounded-full font-sans text-[15px] font-medium text-muted border border-white/15 hover:text-white hover:border-white/30 transition-all no-underline">Or book a call</a>
        </div>
        <div class="flex justify-center gap-10 flex-wrap">
          <div class="text-[13px] text-muted"><strong class="text-lime font-medium">1.</strong> You write about your product</div>
          <div class="text-[13px] text-muted"><strong class="text-lime font-medium">2.</strong> We think about what to test</div>
          <div class="text-[13px] text-muted"><strong class="text-lime font-medium">3.</strong> 30-min call to discuss</div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
