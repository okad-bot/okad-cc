---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const emailCreators = "mailto:olga@okad.agency?subject=Tech%20UGC%20%E2%80%94%20creator%20curation%20for%20our%20brand";
const emailBroll = "mailto:olga@okad.agency?subject=Tech%20UGC%20%E2%80%94%20B-roll%20production";
const emailGeneral = "mailto:olga@okad.agency?subject=Tech%20UGC%20%E2%80%94%20tell%20us%20about%20your%20product";
const calHref = "https://calendly.com/okad_calls/first";
---

<Layout
  title="Tech UGC — The Complete Guide | OKAD Agency"
  description="Everything about Tech UGC: what it is, how brands use it, how creators earn, and how to build a high-volume content engine. An open reference by OKAD Agency."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="pt-20 md:pt-24 pb-10 text-center bg-bg">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="inline-flex items-center gap-1.5 text-[12px] font-medium text-accent bg-[rgba(99,102,241,.06)] border border-[rgba(99,102,241,.18)] rounded-full px-3.5 py-1.5 mb-6">
          Open reference &middot; September 2026
        </div>
        <h1 class="font-display font-bold text-[clamp(28px,5vw,48px)] leading-[1.1] tracking-[-0.03em] text-ink mb-4">
          Tech UGC: <span class="text-accent">The Complete Guide</span>
        </h1>
        <p class="text-[18px] text-ink-2 max-w-[600px] mx-auto leading-[1.6] mb-8">
          Tech UGC is high-volume short-form video produced by creators and posted on a brand's own social accounts. Creators get paid per view. Brands get a constant feed of native content. This guide covers everything.
        </p>
        <div class="flex gap-3 justify-center flex-wrap mb-8">
          <a href={emailCreators} class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-sans text-[14px] font-semibold bg-accent text-white hover:bg-accent-hover transition-all no-underline">Order creator curation &rarr;</a>
          <a href={emailBroll} class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-sans text-[14px] font-semibold bg-card text-ink border border-border hover:border-accent hover:text-accent transition-all no-underline">Order B-roll production &rarr;</a>
        </div>
        <div class="flex gap-5 flex-wrap justify-center font-mono text-[12px] text-muted">
          <span>TikTok</span>
          <span>Reels</span>
          <span>Shorts</span>
          <span>CPM $2&ndash;$8</span>
          <span>No followers needed</span>
          <span>Pay-per-view</span>
        </div>
      </div>
    </section>

    <!-- How it works grid -->
    <section class="py-8">
      <div class="max-w-[800px] mx-auto px-6">
        <h2 class="font-display text-[22px] font-bold tracking-[-0.02em] text-center mb-5">How Tech UGC Works</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F4CB;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Brand Posts a Brief</h3>
            <p class="text-[12px] text-muted leading-[1.4]">The brand defines what content it needs: niche, format, tone, product angle. Creators apply.</p>
          </div>
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F3AC;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Creators Film &amp; Post</h3>
            <p class="text-[12px] text-muted leading-[1.4]">Creators get posting access to the brand's social accounts. They produce and publish directly.</p>
          </div>
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F4B0;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Paid Per View</h3>
            <p class="text-[12px] text-muted leading-[1.4]">Creators earn per 1,000 views (CPM) or per install (CPA). More views = more money.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TOC -->
    <section class="py-10 border-t border-b border-border">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-muted-2 mb-4">Contents</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
          {[
            { num: "01", text: "Overview", href: "#overview" },
            { num: "02", text: "What Is Tech UGC?", href: "#what" },
            { num: "03", text: "History & Context", href: "#history" },
            { num: "04", text: "How It Works", href: "#how" },
            { num: "05", text: "For Creators", href: "#creators" },
            { num: "06", text: "For Brands & Agencies", href: "#brands" },
            { num: "07", text: "Economics", href: "#economics" },
            { num: "08", text: "Format Libraries", href: "#formats" },
            { num: "09", text: "Metrics & Benchmarks", href: "#metrics" },
            { num: "10", text: "Account Setup & Warmup", href: "#warmup" },
            { num: "11", text: "Multi-Account Strategy", href: "#multi" },
            { num: "12", text: "Glossary", href: "#glossary" },
            { num: "13", text: "FAQ", href: "#faq" },
          ].map((item) => (
            <a href={item.href} class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[14px] text-ink-2 font-medium hover:bg-bg-alt transition-colors no-underline">
              <span class="font-mono text-[11px] font-medium text-accent min-w-[22px]">{item.num}</span>
              {item.text}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 01 Overview -->
    <section class="guide-section" id="overview">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">01 &mdash; Overview</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Tech UGC inverts the creator economy</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Creators post on the brand's account, not their own</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Pay is tied to views or installs &mdash; not deliverables</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Volume is high: tens to hundreds of videos per brand each month</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Traditional creators build a personal audience and sell either ad revenue or sponsored posts. In Tech UGC, the creator's audience doesn't matter. They publish on the brand's social accounts &mdash; the "canvas" &mdash; and get paid for performance.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">The model grew up inside consumer apps, SaaS, and AI products that need a constant feed of short-form video. Hence the names: Tech UGC (who buys it), Canvas UGC (where it's posted), and High-Volume UGC (how much gets made).</p>
        <ul class="list-none p-0 space-y-2">
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[100px]">Posted on:</strong> the brand's accounts</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[100px]">Paid:</strong> per 1,000 views (CPM) or per install (CPA)</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[100px]">Volume:</strong> tens to hundreds of videos / brand / month</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[100px]">Where:</strong> TikTok, Reels, Shorts, Facebook Reels</li>
        </ul>
      </div>
    </section>

    <!-- 02 What Is Tech UGC? -->
    <section class="guide-section" id="what">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">02 &mdash; Definition</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">What is Tech UGC?</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">An external creator films and posts video on the brand's account</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">They get paid for performance, not delivery</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Tech UGC</strong> (also called Canvas UGC or High-Volume UGC) is a content production model where an external creator scripts, films, edits, and publishes short-form video on a brand's social account &mdash; paid by performance, not deliverables.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">A quick example</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">A creator films a 20-second tip video using a study app, posts it on the app's TikTok, the post earns 200,000 views, and the creator is paid that brand's CPM (e.g. $4 / 1,000 views) for those views. That's one Tech UGC post.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Synonyms in common use</h3>
        <ul class="pl-5 mb-4 space-y-2 text-ink-2">
          <li><strong>Canvas UGC</strong> &mdash; named after the brand's social account (the "canvas") where content is posted</li>
          <li><strong>Tech UGC</strong> &mdash; named after the primary buyers: SaaS, consumer apps, and AI brands</li>
          <li><strong>High-Volume UGC</strong> &mdash; emphasises the production cadence (dozens of videos per month per creator)</li>
          <li><strong>Brand-account UGC</strong> or account farming &mdash; older, informal terms used inside operator communities</li>
        </ul>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">What it is not</h3>
        <ul class="pl-5 mb-4 space-y-2 text-ink-2">
          <li><strong>Not influencer marketing</strong> &mdash; the creator's audience is not part of the deal</li>
          <li><strong>Not traditional UGC ads</strong> &mdash; the brand is not licensing footage to run as paid media; the creator publishes organically</li>
          <li><strong>Not affiliate marketing</strong> &mdash; payouts are tied to view volume or install volume on the brand canvas, not commission on referred sales</li>
        </ul>
      </div>
    </section>

    <!-- 03 History -->
    <section class="guide-section" id="history">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">03 &mdash; History</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">History &amp; context</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Took shape between 2023&ndash;2025</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Started in mobile apps and study tools (Quizlet, Jenni AI, Studyflash, Coconote)</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Now the dominant organic playbook for tech brands</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Three forces converged: short-form video dominance, rising paid acquisition costs, and the discovery power of brand-owned accounts.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">Operators stopped paying creators to post on their own profiles &mdash; and started paying them to flood the brand's account instead. The pattern was formalised in the mobile app and study-tool space, where brands like Quizlet, Jenni AI, Studyflash and Coconote scaled to hundreds of millions of monthly views through paid creator networks.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">By 2025, the model had spread beyond apps into SaaS, fintech, health &amp; wellness, and e-commerce. Any brand that needs organic short-form video at scale is now a potential Tech UGC buyer.</p>
      </div>
    </section>

    <!-- 04 How It Works -->
    <section class="guide-section" id="how">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">04 &mdash; Mechanics</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">How it works</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Creators apply, get access, post, get paid by views</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Brands recruit, track, attribute, pay automatically</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">The hard part isn't creative &mdash; it's tracking and payouts</li>
          </ul>
        </div>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">For the creator</h3>
        <ol class="list-none p-0 counter-reset-step space-y-0">
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step">Apply to a brand's open Tech UGC campaign</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step">Receive a brief, posting access, and product credentials</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step">Produce and publish short-form video on the brand's social accounts</li>
          <li class="py-3.5 pl-[52px] relative text-ink-2 guide-step">Each post is tracked; the creator is paid based on the views or installs it generates</li>
        </ol>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">For the brand</h3>
        <ol class="list-none p-0 counter-reset-step space-y-0">
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step">Define the canvas &mdash; which accounts and which platforms</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step">Recruit creators and grant them posting access</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step">Track every video posted across every platform; attribute views to the right creator</li>
          <li class="py-3.5 pl-[52px] relative text-ink-2 guide-step">Pay creators automatically against an agreed CPM or CPA</li>
        </ol>

        <p class="text-ink-2 leading-[1.65] mt-6 mb-4"><strong>The bottleneck is rarely creative.</strong> One brand &times; 30 creators &times; 4 platforms = thousands of posts per quarter. Spreadsheets break &mdash; which is why teams running this at scale need dedicated systems and experienced operators.</p>
      </div>
    </section>

    <!-- 05 For Creators -->
    <section class="guide-section" id="creators">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">05 &mdash; For Creators</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Tech UGC for creators: how to start</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">No followers required</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Skills that matter: hooks, editing, consistency</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">A phone is enough gear</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Tech UGC lowered the barrier to earning from short-form video. No audience needed &mdash; only scripting, filming, and editing. New creators commonly earn a few hundred to a few thousand dollars / month in their first 90 days. Experienced ones stack multiple brand canvases and scale further.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Skills that matter</h3>
        <ul class="pl-5 mb-4 space-y-2 text-ink-2">
          <li>Writing strong hooks (the first 1&ndash;2 seconds of a video)</li>
          <li>Editing in a native short-form style (CapCut, in-app TikTok / Reels editors)</li>
          <li>Understanding the conventions of each platform &mdash; Reels is not Shorts is not TikTok</li>
          <li>Producing consistently &mdash; most paid canvases expect 10&ndash;30 videos per month</li>
        </ul>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">How to start, step by step</h3>
        <ol class="list-none p-0 counter-reset-step space-y-0">
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step">Pick 1&ndash;2 niches you can film natively (apps, AI, study, fitness, finance)</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step">Recreate 5&ndash;10 viral short-form videos in that niche to build a small portfolio</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step">Apply to open brand campaigns on marketplaces or through agencies</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step">Accept posting access and start producing 10&ndash;30 videos per month</li>
          <li class="py-3.5 pl-[52px] relative text-ink-2 guide-step">Get paid per view &mdash; scale by stacking multiple brand canvases</li>
        </ol>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">A creator's daily workflow</h3>
        <ul class="pl-5 mb-4 space-y-2 text-ink-2">
          <li>Script a hook (the first 1&ndash;2 seconds)</li>
          <li>Film on a phone in natural light</li>
          <li>Edit a 15&ndash;45s short-form video in CapCut</li>
          <li>Post on the brand's TikTok / Reels / Shorts</li>
          <li>Repeat &mdash; most active Tech UGC creators ship 1&ndash;3 posts per day</li>
        </ul>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Equipment</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">A modern smartphone, decent natural light, and a free editing app. Most top performers film entirely on their phone.</p>
      </div>
    </section>

    <!-- 06 For Brands -->
    <section class="guide-section" id="brands">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">06 &mdash; For Brands &amp; Agencies</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Tech UGC for brands and agencies</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Now a primary organic channel for apps, SaaS, AI, fintech</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Native short-form at favourable cost-per-view</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Stalls without solid attribution + automated payouts</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">For consumer apps, SaaS, AI products, and increasingly fintech and e-commerce, Tech UGC is now a primary organic acquisition channel. The appeal: a continuous stream of native, platform-fluent short-form video at a cost-per-view that beats most paid media &mdash; with no creative approval bottleneck.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">What teams need to operate it</h3>
        <ul class="pl-5 mb-4 space-y-2 text-ink-2">
          <li>A creator network &mdash; sourced directly or through an agency</li>
          <li>Posting access to brand accounts, with safe handoffs</li>
          <li>Cross-platform tracking that resolves which creator posted which video</li>
          <li>Automated payouts against an agreed CPM or CPA model</li>
        </ul>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>The last two are where most in-house attempts stall.</strong> Without reliable attribution and automated payouts, running 20+ creators in parallel quickly becomes unmanageable.</p>

        <div class="bg-card border border-border rounded-xl p-6 my-6 flex gap-4 items-start flex-col sm:flex-row">
          <div class="w-11 h-11 rounded-[10px] bg-[rgba(99,102,241,.06)] border border-[rgba(99,102,241,.12)] flex items-center justify-center text-[20px] shrink-0">&#9670;</div>
          <div>
            <h4 class="font-display text-[16px] font-semibold mb-1"><a href={emailCreators} class="text-ink hover:text-accent transition-colors no-underline">OKAD runs Tech UGC programs for brands</a></h4>
            <p class="text-[14px] text-muted m-0 leading-[1.5]">Full-service Tech UGC operations &mdash; creator sourcing, briefing, tracking, attribution, and payouts. We run the program so you don't have to.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Mid CTA -->
    <section class="py-10">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="bg-dark rounded-2xl p-10 md:p-14 text-center">
          <h2 class="font-display font-bold text-[clamp(22px,3.5vw,32px)] tracking-[-0.02em] text-white mb-3">Want OKAD to run Tech UGC for your brand?</h2>
          <p class="text-[15px] text-muted max-w-[480px] mx-auto leading-[1.6] mb-6">We handle creator selection, scripting, B-roll production, and program management. You get a content engine that runs itself.</p>
          <div class="flex gap-3 justify-center flex-wrap">
            <a href={emailCreators} class="inline-flex items-center px-5 py-2.5 rounded-xl font-sans text-[14px] font-semibold bg-white text-ink hover:bg-[rgba(99,102,241,.06)] hover:text-accent transition-all no-underline">Order creator curation &rarr;</a>
            <a href={emailBroll} class="inline-flex items-center px-5 py-2.5 rounded-xl font-sans text-[14px] font-semibold text-muted border border-white/15 hover:text-white hover:border-white/30 transition-all no-underline">Order B-roll production &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 07 Economics -->
    <section class="guide-section" id="economics">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">07 &mdash; Economics</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">How creators and brands make money</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Most pay is per 1,000 views (CPM) or per install (CPA)</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Typical CPM in 2025&ndash;2026: ~$2&ndash;$8</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Rates depend on category, platform, and track record</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Pay is almost always CPM (per 1,000 views) or CPA (per install / conversion). Typical CPM in 2025&ndash;2026: $2&ndash;$8 per 1,000 views, with variability driven by brand category, platform, and historical performance.</p>

        <div class="overflow-x-auto rounded-xl border border-border bg-card mb-6">
          <table class="w-full border-collapse text-[14px]">
