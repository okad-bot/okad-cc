                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Tech UGC</th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Traditional UGC</th>
              </tr>
