              </tr>
            </thead>
            <tbody>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Primary success metric</td><td class="px-4 py-2.5 border-b border-border text-ink-2">CPA (cost per acquisition)</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Views + signups</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Hook effectiveness</td><td class="px-4 py-2.5 border-b border-border text-ink-2">3s retention rate</td><td class="px-4 py-2.5 border-b border-border text-ink-2">3s retention rate</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Engagement quality</td><td class="px-4 py-2.5 border-b border-border text-ink-2">CTR (1&ndash;2% benchmark)</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Saves, shares, comments</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Business outcome</td><td class="px-4 py-2.5 border-b border-border text-ink-2">ROAS (3x+ benchmark)</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Installs, signups, revenue</td></tr>
