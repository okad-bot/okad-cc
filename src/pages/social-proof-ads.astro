---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const emailProof = "mailto:olga@okad.agency?subject=Social%20proof%20ad%20production%20%E2%80%94%20tell%20us%20about%20your%20brand";
const emailGeneral = "mailto:olga@okad.agency?subject=Social%20proof%20ads%20%E2%80%94%20general%20inquiry";
const calHref = "https://calendly.com/okad_calls/first";
---

<Layout
  title="Social Proof Ads — The Complete Guide to Testimonial & Review Ad Creative | OKAD"
  description="Social proof ads use testimonials, reviews, ratings, and user stories as primary creative elements. 92% of consumers trust peer recommendations over brand advertising. This guide covers proof types, ad structure, collection methods, platform formats, compliance, and scaling."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="pt-20 md:pt-24 pb-10 text-center bg-bg">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="inline-flex items-center gap-1.5 text-[12px] font-medium text-accent bg-[rgba(99,102,241,.06)] border border-[rgba(99,102,241,.18)] rounded-full px-3.5 py-1.5 mb-6">
          Open reference &middot; September 2026
        </div>
        <h1 class="font-display font-bold text-[clamp(28px,5vw,48px)] leading-[1.1] tracking-[-0.03em] text-ink mb-4">
          Social Proof Ads: <span class="text-accent">The Complete Guide</span>
        </h1>
        <p class="text-[18px] text-ink-2 max-w-[600px] mx-auto leading-[1.6] mb-8">
          Social proof ads use peer evidence &mdash; testimonials, reviews, ratings, user stories &mdash; as the primary creative element. 92% of consumers trust peer recommendations over brand advertising. This is not a new concept. It is the most effective ad format, now scaled through UGC.
        </p>
        <div class="flex gap-3 justify-center flex-wrap mb-8">
          <a href={emailProof} class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-sans text-[14px] font-semibold bg-accent text-white hover:bg-accent-hover transition-all no-underline">Order social proof ad creative &rarr;</a>
          <a href={calHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-sans text-[14px] font-semibold bg-card text-ink border border-border hover:border-accent hover:text-accent transition-all no-underline">Book a call &rarr;</a>
        </div>
        <div class="flex gap-5 flex-wrap justify-center font-mono text-[12px] text-muted">
          <span>92% trust rate</span>
          <span>15&ndash;30% lower CPA</span>
          <span>UGC testimonials</span>
          <span>Multi-platform</span>
          <span>Scalable proof</span>
        </div>
      </div>
    </section>

    <!-- How it works grid -->
    <section class="py-8">
      <div class="max-w-[800px] mx-auto px-6">
        <h2 class="font-display text-[22px] font-bold tracking-[-0.02em] text-center mb-5">How Social Proof Ads Work</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F3AF;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Collect Proof</h3>
            <p class="text-[12px] text-muted leading-[1.4]">Gather testimonials, reviews, and case studies from real customers. Build a library of authentic social proof assets.</p>
          </div>
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F3AC;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Produce Creative</h3>
            <p class="text-[12px] text-muted leading-[1.4]">Turn social proof into native ad formats &mdash; video testimonials, review carousels, rating overlays, case study clips.</p>
          </div>
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F4C8;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Test &amp; Scale</h3>
            <p class="text-[12px] text-muted leading-[1.4]">A/B test proof types, hooks, and combinations. Scale winners across platforms. Social proof ads deliver 15&ndash;30% lower CPA.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TOC -->
    <section class="py-10 border-t border-b border-border">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-muted-2 mb-4">Contents</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
          {[
            { num: "01", text: "Overview", href: "#overview" },
            { num: "02", text: "Types of Social Proof", href: "#types" },
            { num: "03", text: "The Social Proof Hierarchy", href: "#hierarchy" },
            { num: "04", text: "Ad Structure", href: "#structure" },
            { num: "05", text: "How to Collect Social Proof", href: "#collect" },
            { num: "06", text: "Social Proof vs Other Ad Types", href: "#comparison" },
            { num: "07", text: "Platform-Specific Formats", href: "#platforms" },
            { num: "08", text: "Legal & Compliance", href: "#legal" },
            { num: "09", text: "Scaling Social Proof Ads", href: "#scaling" },
            { num: "10", text: "Glossary", href: "#glossary" },
            { num: "11", text: "FAQ", href: "#faq" },
          ].map((item) => (
            <a href={item.href} class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[14px] text-ink-2 font-medium hover:bg-bg-alt transition-colors no-underline">
              <span class="font-mono text-[11px] font-medium text-accent min-w-[22px]">{item.num}</span>
              {item.text}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 01 Overview -->
    <section class="guide-section" id="overview">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">01 &mdash; Overview</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Peer evidence is the strongest creative</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Social proof ads use testimonials, reviews, ratings, and user stories as the primary creative element</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">92% of consumers trust peer recommendations over brand advertising (Nielsen)</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Social proof ads deliver 15&ndash;30% lower CPA than non-proof creative in head-to-head tests</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">UGC testimonials combine user credibility with production scalability</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Social proof is the psychological phenomenon where people adopt the actions and opinions of others to guide their own behavior. In advertising, this means showing potential customers that real people &mdash; not the brand &mdash; vouch for the product. The concept is decades old: word-of-mouth has always been the strongest driver of purchase decisions.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">What has changed is scale. Before UGC, collecting and producing social proof creative was expensive and slow. You needed professional testimonial shoots, paid actors, or painstaking review compilation. Today, brands can source authentic testimonial content from real creators at volume &mdash; 10, 20, 50 unique proof assets per month &mdash; and test them systematically across platforms.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">The data is consistent: ads that lead with peer evidence outperform brand-centric creative. When a real person describes their experience with a product, the viewer processes it differently than when the brand makes the same claim. This is not about production quality. A shaky phone video of a genuine customer review outperforms a polished brand spot because the viewer trusts the source.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">This guide covers every aspect of social proof ads: what types exist, how they are structured, how to collect proof, platform-specific formats, legal requirements, and how to build a scalable system. Related guides: <a href="/canvas-ugc" class="text-accent hover:underline">Canvas UGC</a>, <a href="/ugc-ads" class="text-accent hover:underline">UGC Ads</a>, <a href="/guide" class="text-accent hover:underline">Creative Testing</a>, <a href="/tech-ugc" class="text-accent hover:underline">Tech UGC</a>.</p>
      </div>
    </section>

    <!-- 02 Types of Social Proof -->
    <section class="guide-section" id="types">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">02 &mdash; Types of Social Proof</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Six formats that drive trust</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Video testimonials are the highest-converting social proof format</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Screenshot reviews and rating overlays work well in static and carousel formats</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Before/after transformations provide the most compelling visual proof</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Not all social proof is created equal. The format you choose depends on your product, your audience, and your platform. Video testimonials carry the most weight because they are hardest to fake &mdash; a real person on camera, speaking in their own words, is inherently more credible than text on a screen. But text reviews, rating screenshots, and aggregate stats each have their place in the creative mix.</p>

        <div class="overflow-x-auto rounded-xl border border-border bg-card mb-6">
          <table class="w-full border-collapse text-[14px]">
            <thead class="bg-bg">
              <tr>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Type</th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Format</th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Best Platform</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="px-4 py-2.5 border-b border-border text-ink font-medium">Video testimonial</td>
                <td class="px-4 py-2.5 border-b border-border text-ink">15&ndash;60s selfie-style video</td>
                <td class="px-4 py-2.5 border-b border-border text-ink">TikTok, Meta Reels, YouTube Shorts</td>
              </tr>
              <tr>
                <td class="px-4 py-2.5 border-b border-border text-ink font-medium">Screenshot review</td>
                <td class="px-4 py-2.5 border-b border-border text-ink">Static image or carousel</td>
                <td class="px-4 py-2.5 border-b border-border text-ink">Meta Feed, Instagram Stories</td>
              </tr>
              <tr>
                <td class="px-4 py-2.5 border-b border-border text-ink font-medium">Rating overlay</td>
                <td class="px-4 py-2.5 border-b border-border text-ink">Star rating graphic on video/image</td>
                <td class="px-4 py-2.5 border-b border-border text-ink">Meta, YouTube pre-roll</td>
              </tr>
              <tr>
                <td class="px-4 py-2.5 border-b border-border text-ink font-medium">&ldquo;X people bought this&rdquo;</td>
                <td class="px-4 py-2.5 border-b border-border text-ink">Counter/stat overlay on creative</td>
                <td class="px-4 py-2.5 border-b border-border text-ink">Meta, Google Display</td>
              </tr>
              <tr>
                <td class="px-4 py-2.5 border-b border-border text-ink font-medium">Case study ad</td>
                <td class="px-4 py-2.5 border-b border-border text-ink">60&ndash;120s narrative video</td>
                <td class="px-4 py-2.5 border-b border-border text-ink">YouTube, LinkedIn, Meta</td>
              </tr>
              <tr>
                <td class="px-4 py-2.5 text-ink font-medium">Before/after transformation</td>
                <td class="px-4 py-2.5 text-ink">Split-screen video or carousel</td>
                <td class="px-4 py-2.5 text-ink">TikTok, Instagram Reels, Meta</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Video testimonials</strong> are the gold standard. A real customer describing their experience on camera carries more persuasive weight than any other format. The authenticity of selfie-style video &mdash; natural lighting, casual setting, unscripted delivery &mdash; signals genuine experience rather than paid promotion.</p>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Screenshot reviews</strong> work because they reference a trusted third-party platform. A screenshot of an Amazon review, a Google review, or an App Store rating carries the authority of that platform. These are fast to produce and effective in carousel formats where you stack multiple reviews in sequence.</p>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Before/after transformations</strong> are the most visually compelling proof type. They work for any product with a visible outcome: skincare, fitness, home renovation, software dashboards, productivity tools. The visual contrast does the persuading &mdash; the viewer sees the result without needing to trust a verbal claim.</p>
      </div>
    </section>

    <!-- 03 The Social Proof Hierarchy -->
    <section class="guide-section" id="hierarchy">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">03 &mdash; The Social Proof Hierarchy</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Why user-level proof wins</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Trust hierarchy: Friend &gt; User &gt; Expert &gt; Celebrity</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">User-level proof is the most scalable tier for paid advertising</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">UGC testimonials combine user credibility with production scalability</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Social proof operates on a trust hierarchy. At the top is the recommendation of a friend &mdash; the most trusted source, but impossible to scale in advertising. At the bottom is celebrity endorsement &mdash; high awareness but low trust, because everyone knows it is paid. The sweet spot for ad creative sits at the user level.</p>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Celebrity endorsement</strong> creates awareness but low trust. Viewers know the celebrity was paid. The message is &ldquo;this famous person took money to say this.&rdquo; It works for top-of-funnel brand building but underperforms for direct response.</p>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Expert endorsement</strong> carries authority in specific verticals. A dermatologist recommending skincare, a mechanic endorsing motor oil, a chef endorsing cookware. Expert proof works when the purchase decision involves technical risk or specialized knowledge.</p>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>User endorsement</strong> is the most scalable and most effective tier for paid ads. A regular person describing their genuine experience with a product is relatable, believable, and reproducible. You can source 50 unique user testimonials through UGC creator programs. Each testimonial speaks to a different use case, demographic, or pain point &mdash; giving you creative diversity at scale.</p>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Friend recommendation</strong> is the most trusted tier but cannot be manufactured. The closest you can get in advertising is a UGC testimonial that feels like a friend sharing a recommendation &mdash; casual, authentic, filmed in a natural setting. This is why selfie-style UGC testimonials outperform polished brand content: they mimic the friend tier.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">UGC testimonials sit in the overlap between user credibility and production scalability. A single creator costs $50&ndash;$200 per testimonial clip. Scaling to 50+ clips per month is operationally straightforward with a managed <a href="/creator-network" class="text-accent hover:underline">creator network</a>. This makes user-level proof the foundation of any social proof ad strategy.</p>
      </div>
    </section>

    <!-- 04 Ad Structure -->
    <section class="guide-section" id="structure">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">04 &mdash; Ad Structure</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">The narrative arc that converts</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Every social proof ad follows a five-part structure: hook, problem, discovery, result, CTA</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">The hook must establish credibility within the first 3 seconds</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Results should be specific and measurable whenever possible</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Social proof ads that convert follow a consistent narrative structure. The viewer needs to identify with the customer, understand the problem, see the product as the solution, and believe the result. This five-step arc applies whether the ad is a 15-second TikTok or a 90-second YouTube case study.</p>

        <ol class="list-none p-0 counter-reset-step space-y-0">
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Customer story hook.</strong> Open with a relatable statement that establishes the person as a real user: &ldquo;I&rsquo;ve been using this for 6 months&rdquo; or &ldquo;I was skeptical at first, but&hellip;&rdquo; The hook must stop the scroll and signal that this is a real person, not a brand ad.</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Problem.</strong> Describe the pain point the customer experienced before finding the product. Be specific: &ldquo;My skin was breaking out every week&rdquo; is stronger than &ldquo;I had skin issues.&rdquo; The problem creates identification &mdash; the viewer recognizes their own situation.</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Discovery.</strong> How the customer found the product. This should feel organic: &ldquo;My friend told me about it&rdquo; or &ldquo;I saw it on TikTok.&rdquo; The discovery moment bridges the problem and the solution without feeling like a sales pitch.</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Result.</strong> The transformation or outcome after using the product. Specifics convert: &ldquo;My skin cleared up in 3 weeks&rdquo; beats &ldquo;it really works.&rdquo; Visual proof (before/after, product demo, screen recording) amplifies the verbal claim.</li>
          <li class="py-3.5 pl-[52px] relative text-ink-2 guide-step"><strong>Call to action.</strong> End with a natural recommendation: &ldquo;You should try it&rdquo; or &ldquo;Link in bio.&rdquo; The CTA should feel like a friend&rsquo;s suggestion, not a sales close. Overlay the brand&rsquo;s CTA (discount code, URL) as a text card or end screen.</li>
        </ol>

        <p class="text-ink-2 leading-[1.65] mb-4 mt-6">This structure works because it mirrors how people naturally share recommendations. Nobody leads with &ldquo;buy this product.&rdquo; They start with their story, describe their problem, explain how they found the solution, and share the result. Social proof ads that follow this arc feel like content, not advertising &mdash; which is exactly why they outperform.</p>
      </div>
    </section>

    <!-- 05 How to Collect Social Proof -->
    <section class="guide-section" id="collect">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">05 &mdash; How to Collect Social Proof</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Building your proof library</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Five collection methods: post-purchase surveys, review mining, creator testimonials, case studies, incentivized video reviews</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Aim for 50+ proof assets before launching a social proof ad campaign</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Fresh proof matters &mdash; rotate testimonials every 4&ndash;6 weeks to prevent fatigue</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">The biggest bottleneck in social proof advertising is not creative production &mdash; it is proof collection. Most brands have reviews scattered across platforms, buried in email, or sitting in customer support tickets. Building a systematic collection process is the foundation of scalable social proof ads.</p>

        <ol class="list-none p-0 counter-reset-step space-y-0">
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Post-purchase surveys.</strong> Send a follow-up email 7&ndash;14 days after purchase asking customers to share their experience. Include a simple form with open-ended questions: &ldquo;What problem did this solve?&rdquo; and &ldquo;What result have you seen?&rdquo; Offer a small incentive (10% off next order) for video responses.</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Review mining.</strong> Audit existing reviews on Amazon, Google, Trustpilot, App Store, and social media. Extract the most specific and compelling reviews. Screenshot them for static ads or use the quotes as script foundations for video testimonials.</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Creator testimonials.</strong> Brief <a href="/ugc-creator" class="text-accent hover:underline">UGC creators</a> to film authentic testimonial videos. Send them the product, give them 5&ndash;7 days to use it, then have them film a genuine reaction. Cost: $50&ndash;$200 per clip. Scale: 10&ndash;30 clips per month through a managed creator network.</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Case studies.</strong> Identify your best customers and produce in-depth case study content. Interview them on video about their problem, their journey, and their results. Case studies work best for B2B and high-ticket products where the purchase decision is more considered.</li>
          <li class="py-3.5 pl-[52px] relative text-ink-2 guide-step"><strong>Incentivized video reviews.</strong> Offer existing customers a reward (store credit, free product, discount) in exchange for a short video review filmed on their phone. Provide simple guidelines: film in natural light, speak to the camera, describe one specific result. These authentic clips become your highest-performing ad assets.</li>
        </ol>

        <p class="text-ink-2 leading-[1.65] mb-4 mt-6">The goal is to build a <strong>social proof library</strong> &mdash; a searchable collection of testimonials, reviews, case studies, and video clips organized by theme, product, customer segment, and platform. With 50+ assets in your library, you have enough material to test multiple proof angles, rotate creative to prevent fatigue, and scale winning combinations across platforms.</p>
      </div>
    </section>

    <!-- Mid CTA -->
    <section class="py-10">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="bg-dark rounded-2xl p-10 md:p-14 text-center">
          <h2 class="font-display font-bold text-[clamp(22px,3.5vw,32px)] tracking-[-0.02em] text-white mb-3">Need social proof ad creative?</h2>
          <p class="text-[15px] text-muted max-w-[480px] mx-auto leading-[1.6] mb-6">We produce testimonial videos, review carousels, and case study ads with real creators. From proof collection to platform-ready creative.</p>
          <div class="flex gap-3 justify-center flex-wrap">
            <a href={emailProof} class="inline-flex items-center px-5 py-2.5 rounded-xl font-sans text-[14px] font-semibold bg-white text-ink hover:bg-[rgba(99,102,241,.06)] hover:text-accent transition-all no-underline">Order social proof ad creative &rarr;</a>
            <a href={calHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-5 py-2.5 rounded-xl font-sans text-[14px] font-semibold text-muted border border-white/15 hover:text-white hover:border-white/30 transition-all no-underline">Book a call &rarr;</a>
