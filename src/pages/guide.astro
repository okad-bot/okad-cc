          { term: "CPA", def: "Cost per acquisition — the dollar amount to acquire one customer through a specific ad creative." },
          { term: "Hook", def: "The first 1-2 seconds of an ad. The largest single predictor of performance." },
          { term: "Modular script", def: "A script designed to be remixed: one body with multiple interchangeable hooks and CTAs." },
          { term: "Scale / Iterate / Kill", def: "The three outcomes for every tested creative. Scale means increase spend. Iterate means change one variable. Kill means stop." },
          { term: "Angle", def: "A specific pain point or benefit used as the core message of an ad variation." },
          { term: "Creator-angle fit", def: "How well a specific creator's delivery matches a specific product angle. Explains most CPA variance." },
          { term: "B-roll", def: "Supporting footage (product close-ups, lifestyle shots, demos) used in voiceover-style ads." },
          { term: "Winner hit rate", def: "Percentage of tested creatives that meet or beat the target CPA. ~30% in a well-run batch." },
