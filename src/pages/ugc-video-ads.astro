        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Key terms</h2>

        {[
          { term: "UGC video ad", def: "A paid advertisement built from creator-filmed content rather than studio-produced footage. Designed to look native to the platform feed." },
          { term: "Hook rate", def: "The percentage of viewers who watch past the first three seconds of an ad. The single most important creative metric." },
          { term: "CTR (click-through rate)", def: "The percentage of viewers who click an ad after watching it. UGC ads on Meta typically achieve 1.5-3% vs 0.5-1% for studio creative." },
          { term: "CPA (cost per acquisition)", def: "What a brand pays per conversion. UGC video ads typically reduce CPA by 30-60% compared to studio creative." },
          { term: "ROAS (return on ad spend)", def: "Revenue generated per dollar of ad spend. The ultimate measure of creative investment payoff." },
          { term: "Creative fatigue", def: "The decline in ad performance as the target audience sees it repeatedly. UGC sustains 3-6 weeks vs 7-14 days for studio." },
          { term: "Hook variant", def: "A distinct opening line for an ad. Multiple hooks let you test which entry point resonates without reshooting the entire ad." },
          { term: "Spark Ads", def: "TikTok's native ad format that boosts an existing organic post as paid media, retaining all engagement." },
          { term: "Partnership Ads", def: "Meta's equivalent of Spark Ads — promoting posts as paid ads on Instagram or Facebook from the creator's handle." },
          { term: "Whitelisting", def: "Running paid ads from a creator's social account handle rather than the brand's account. Creates a native ad experience." },
          { term: "Perpetual commercial license", def: "Usage rights with unlimited duration, all platforms, and full modification rights. Eliminates the burden of tracking expiration dates." },
          { term: "Modular scripting", def: "Writing scripts with interchangeable hooks, bodies, and CTAs so a single shoot yields 3-5 distinct ad variations." },
        ].map((item) => (
