        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Key terms</h2>

        {[
          { term: "UGC creator", def: "A person who produces authentic-looking content for brands. Paid for production skill, not audience access. Follower count is irrelevant." },
          { term: "Whitelabel UGC", def: "Creator-made content delivered to the brand for use as paid ads. The brand runs the content under its own ad account. The creator is not credited publicly." },
          { term: "Camera-facing creator", def: "A UGC creator who appears on screen — talking head, testimonial, unboxing, product demo. Valued for on-camera presence and delivery." },
          { term: "Skill-based creator", def: "A UGC creator who produces content without appearing on camera — screen recordings, voiceover tutorials, motion graphics, editing-heavy formats." },
          { term: "Creator brief", def: "The document a brand provides to a creator specifying product info, messaging, hooks, tone, format, and do's/don'ts. The most important document in UGC production." },
          { term: "Hit rate", def: "The percentage of UGC videos that achieve a target performance threshold (views, engagement, or conversion). Higher hit rate = more efficient production spend." },
          { term: "Canvas UGC creator", def: "A creator who posts content on brand-owned social accounts and is paid per view or through a hybrid model. The brand's account is the 'canvas.'" },
          { term: "Creator portfolio", def: "A collection of a creator's previous UGC work, used by brands to evaluate style, quality, and range before hiring." },
          { term: "Usage rights", def: "The license a brand acquires to use creator content. Defines where, how long, and in what formats the content can be used (organic, paid ads, landing pages)." },
          { term: "Retainer", def: "A fixed monthly payment arrangement where a creator produces an agreed number of videos per month for a brand. Provides income stability for creators and content consistency for brands." },
        ].map((item) => (
