        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Key terms</h2>

        {[
          { term: "Ad fatigue", def: "The gradual decline in ad performance caused by audience overexposure. Measured by rising frequency, declining CTR, and increasing CPA over time." },
          { term: "Frequency", def: "The average number of times each user in your target audience has seen a specific ad. The critical fatigue threshold on Meta is 2.5-3.0." },
          { term: "Andromeda", def: "Meta's ad-ranking system (2024+) that evaluates ~100,000 ad candidates per impression and weights creative freshness as a ranking signal, compressing creative lifespan from ~6 weeks to ~10 days." },
          { term: "Creative lifespan", def: "The period during which an ad performs at or near its peak CPA. On Meta in 2026, average lifespan is 10-14 days for a scaled winning creative." },
          { term: "Banner blindness", def: "A user behavior where repeated exposure to the same ad causes the viewer to scroll past without consciously registering it. The primary mechanism behind ad fatigue." },
          { term: "Creative decay", def: "Synonym for ad fatigue. The measurable decline in performance metrics as an ad ages and audience exposure increases." },
          { term: "Hook swap", def: "Replacing the first 3 seconds of a video ad while keeping the body and CTA intact. The most effective single technique for extending creative lifespan." },
          { term: "Fatigue signal", def: "An early metric change that indicates fatigue is beginning: frequency > 2.0, CTR declining for 3+ days, or hook rate dropping below historical average." },
          { term: "Creative pipeline", def: "A continuous production system that delivers 6-12+ new ad concepts per week, ensuring fresh creative is always ready to replace fatiguing winners." },
          { term: "Dead zone", def: "The gap between one winning creative fatiguing and the next being validated. Causes CPA spikes and budget waste. Prevented by maintaining a continuous pipeline." },
          { term: "Creative health status", def: "A monitoring classification (Green/Yellow/Red) based on frequency, CTR trend, and CPA trend that guides real-time budget allocation decisions." },
        ].map((item) => (
          <div class="py-4 border-b border-border">
            <div class="font-display font-semibold text-ink mb-1">{item.term}</div>
            <div class="text-[14px] text-muted">{item.def}</div>
          </div>
        ))}
      </div>
