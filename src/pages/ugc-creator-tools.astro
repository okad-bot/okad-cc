              <tr><td class="px-4 py-2.5 border-b border-border text-ink font-medium">PandaDoc</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Free e-sign / $19/mo</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Document creation + e-sign + payment collection</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink font-medium">DocuSign</td><td class="px-4 py-2.5 border-b border-border text-ink-2">$10/mo</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Industry-standard e-signature, enterprise integrations</td></tr>
              <tr><td class="px-4 py-2.5 text-ink font-medium">Bonsai</td><td class="px-4 py-2.5 text-ink-2">$21/mo</td><td class="px-4 py-2.5 text-ink-2">All-in-one: contracts + proposals + invoices for freelancers</td></tr>
            </tbody>
          </table>
