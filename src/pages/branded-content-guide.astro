    <!-- 11 Glossary -->
    <section class="guide-section" id="glossary">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">11 &mdash; Glossary</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Key terms</h2>

        {[
          { term: "Branded Content", def: "Content funded by a brand that is designed to inform, entertain, or inspire the audience rather than sell directly. The brand is the sponsor, not the subject. The content earns attention on its own merits." },
          { term: "Content Territory", def: "The topic space where a brand has credible authority to produce content. Defined by the intersection of audience interests and brand expertise. Prevents content from feeling random or off-brand." },
          { term: "Spark Ads", def: "TikTok's native format for boosting organic creator posts as paid ads. All engagement (likes, comments, shares) accumulates on the original post. The most popular branded content ad format globally." },
          { term: "Partnership Ads", def: "Meta's branded content ad format (formerly Branded Content Ads). Creators tag the brand as a paid partner, and the brand promotes the tagged post through Ads Manager on Instagram and Facebook." },
          { term: "Hook Rate", def: "The percentage of viewers who watch past the first 2-3 seconds of a video. The primary quality signal for short-form video branded content. A hook rate above 40% indicates strong opening performance." },
          { term: "Brand Lift Study", def: "A controlled experiment that measures changes in brand awareness, recall, consideration, and purchase intent among audiences exposed to branded content versus a control group not exposed." },
          { term: "Whitelisting", def: "A delivery method where the creator grants the brand permission to run paid ads directly from the creator's social account. Maximizes authenticity but requires the most creator cooperation." },
          { term: "Canvas UGC", def: "OKAD's model for high-volume creator content production. Brands commission multiple creators to produce authentic content at scale, which can then be used as organic posts or amplified as branded content ads." },
          { term: "Incrementality Testing", def: "A measurement methodology that isolates the true causal impact of branded content by comparing outcomes in exposed versus unexposed groups, typically using geographic holdouts." },
          { term: "Content Calendar", def: "A planning document that maps out what content will be published, when, on which platform, and by which creator. Essential for maintaining consistent publishing cadence." },
          { term: "Creator Brief", def: "The document that outlines what a creator should produce: audience insight, content angle, key messages, tone guidelines, format specifications, and compliance requirements. The brief determines content quality." },
          { term: "First-Party Data", def: "Data collected directly from the audience through owned interactions (sign-ups, quizzes, purchases) rather than from third-party cookies or data brokers. Increasingly valuable as privacy regulations tighten." },
          { term: "Native Content", def: "Content that matches the form, feel, and function of the platform where it appears. Branded content succeeds when it feels native to the platform rather than imported from a different medium." },
        ].map((item) => (
          <div class="py-4 border-b border-border">
            <div class="font-display font-semibold text-ink mb-1">{item.term}</div>
            <div class="text-[14px] text-muted">{item.def}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- 12 FAQ -->
