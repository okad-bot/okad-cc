          { term: "CPA", def: "Cost per acquisition — the dollar amount spent on ads to acquire one customer. The primary decision metric in performance creative." },
          { term: "ROAS", def: "Return on ad spend — revenue generated per dollar spent on ads. 3x+ is the benchmark for most categories." },
          { term: "Hook rate", def: "The percentage of viewers who watch past the first 3 seconds. 30-40% is the 2026 benchmark on Meta. The strongest early predictor of CPA." },
