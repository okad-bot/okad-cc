---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const emailPerformance = "mailto:olga@okad.agency?subject=Performance%20creative%20%E2%80%94%20tell%20us%20about%20your%20product";
const emailGeneral = "mailto:olga@okad.agency?subject=Performance%20creative%20inquiry";
const calHref = "https://calendly.com/okad_calls/first";
---

<Layout
  title="Performance Creative — The Complete Guide to Ad Creative That Drives Results | OKAD"
  description="Performance creative is ad creative designed and optimized for measurable results (CPA, ROAS), not brand awareness. This guide covers the system: research, concept, production, testing, analysis, iteration, and how to build a pipeline that finds winners."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="pt-20 md:pt-24 pb-10 text-center bg-bg">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="inline-flex items-center gap-1.5 text-[12px] font-medium text-accent bg-[rgba(99,102,241,.06)] border border-[rgba(99,102,241,.18)] rounded-full px-3.5 py-1.5 mb-6">
          Open reference &middot; September 2026
        </div>
        <h1 class="font-display font-bold text-[clamp(28px,5vw,48px)] leading-[1.1] tracking-[-0.03em] text-ink mb-4">
          Performance Creative: <span class="text-accent">The Complete Guide</span>
        </h1>
        <p class="text-[18px] text-ink-2 max-w-[600px] mx-auto leading-[1.6] mb-8">
          Performance creative is ad creative designed and optimized for measurable results &mdash; CPA, ROAS, and revenue &mdash; not brand awareness or aesthetics. This guide covers how to build a system that turns creative production into a growth engine.
        </p>
        <div class="flex gap-3 justify-center flex-wrap mb-8">
          <a href={emailPerformance} class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-sans text-[14px] font-semibold bg-accent text-white hover:bg-accent-hover transition-all no-underline">Order performance creative &rarr;</a>
          <a href={calHref} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-sans text-[14px] font-semibold bg-card text-ink border border-border hover:border-accent hover:text-accent transition-all no-underline">Book a call &rarr;</a>
        </div>
        <div class="flex gap-5 flex-wrap justify-center font-mono text-[12px] text-muted">
          <span>CPA &amp; ROAS</span>
          <span>Hook-first production</span>
          <span>1 new ad per $3K spend</span>
          <span>UGC-dominant</span>
          <span>Modular &amp; data-driven</span>
        </div>
      </div>
    </section>

    <!-- How it works grid -->
    <section class="py-8">
      <div class="max-w-[800px] mx-auto px-6">
        <h2 class="font-display text-[22px] font-bold tracking-[-0.02em] text-center mb-5">How Performance Creative Works</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F3AF;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Data Decides, Not Taste</h3>
            <p class="text-[12px] text-muted leading-[1.4]">Creative is judged by purchase data &mdash; CPA and ROAS &mdash; not by aesthetics, likes, or creative director opinions.</p>
          </div>
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F3AC;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Hook-First Production</h3>
            <p class="text-[12px] text-muted leading-[1.4]">The first 3 seconds decide everything. Hook rate 30&ndash;40% is the benchmark. Production starts with hooks, not scripts.</p>
          </div>
          <div class="bg-card border border-border rounded-[10px] p-4 text-center">
            <div class="text-[22px] mb-1.5">&#x1F504;</div>
            <h3 class="font-display text-[14px] font-semibold mb-1">Continuous Iteration</h3>
            <p class="text-[12px] text-muted leading-[1.4]">Research, concept, produce, test, analyze, iterate. The system never stops. One new ad per $3K of ad spend is the 2026 benchmark.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TOC -->
    <section class="py-10 border-t border-b border-border">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-muted-2 mb-4">Contents</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
          {[
            { num: "01", text: "Overview", href: "#overview" },
            { num: "02", text: "What Is Performance Creative?", href: "#what" },
            { num: "03", text: "Performance vs Brand Creative", href: "#vs-brand" },
            { num: "04", text: "The Performance Creative System", href: "#system" },
            { num: "05", text: "Hook-First Production", href: "#hooks" },
            { num: "06", text: "UGC as the Dominant Format", href: "#ugc" },
            { num: "07", text: "Modular Production", href: "#modular" },
            { num: "08", text: "Data-Driven Iteration", href: "#iteration" },
            { num: "09", text: "Key Roles & Platform Adaptation", href: "#roles" },
            { num: "10", text: "Glossary", href: "#glossary" },
            { num: "11", text: "FAQ", href: "#faq" },
          ].map((item) => (
            <a href={item.href} class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[14px] text-ink-2 font-medium hover:bg-bg-alt transition-colors no-underline">
              <span class="font-mono text-[11px] font-medium text-accent min-w-[22px]">{item.num}</span>
              {item.text}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 01 Overview -->
    <section class="guide-section" id="overview">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">01 &mdash; Overview</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Performance creative is judged by purchase data, not aesthetics</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Performance creative = ad creative optimized for measurable results (CPA, ROAS)</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">In 2026: one new ad per $3K of ad spend is the production benchmark</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">The system: research &rarr; concept &rarr; production &rarr; test &rarr; analyze &rarr; iterate</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Performance creative is ad creative where the only judge is data. A beautiful ad that doesn't convert is a failure. An ugly ad with a CPA 30% below target is a winner. This distinction separates performance creative from brand creative, where goals like awareness, recall, and aesthetic consistency matter.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">The shift happened gradually, then all at once. By 2026, platforms like Meta and TikTok have made creative the primary lever for ad performance. Targeting is largely automated. Bidding is algorithmic. The creative itself &mdash; what the viewer sees in the first 3 seconds &mdash; is the single biggest variable a brand controls.</p>
        <p class="text-ink-2 leading-[1.65] mb-4">The 2026 benchmark: brands spending $50K&ndash;$500K/month on paid media need approximately one new ad per $3K of ad spend to maintain performance. At $150K/month, that's 50 new ads per month. This volume is only achievable with a systematic approach to creative production.</p>
        <ul class="list-none p-0 space-y-2">
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[120px]">Goal:</strong> measurable business results &mdash; CPA, ROAS, revenue</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[120px]">Method:</strong> systematic production, testing, and iteration</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[120px]">Format:</strong> UGC-dominant, hook-first, modular components</li>
          <li class="flex items-baseline gap-2 py-1.5 text-ink-2"><strong class="text-ink min-w-[120px]">Cadence:</strong> 1 new ad per $3K spend; continuous pipeline</li>
        </ul>
      </div>
    </section>

    <!-- 02 What Is Performance Creative -->
    <section class="guide-section" id="what">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">02 &mdash; Definition</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">What is performance creative?</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Ad creative designed, produced, and measured by business outcomes</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Every creative is a hypothesis tested with real purchase data</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">The opposite of "make it look great and hope it works"</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4"><strong>Performance creative</strong> is ad content &mdash; video, image, or carousel &mdash; where the creative decisions are driven by data, not taste. Every element is chosen to maximize a measurable outcome: lower CPA, higher ROAS, more conversions. The creative is not the end product; the conversion is.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">A quick example</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">A DTC skincare brand produces 15 video ads in a week: 5 different hooks &times; 3 different body narratives. All 15 run simultaneously as Meta ads with $75/day each. After 5 days and $5,625 in test spend, three ads have a CPA 25% below target. Those three get scaled to $500/day. The other twelve get killed or iterated. That's performance creative &mdash; the data chose the winners.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">What performance creative is not</h3>
        <ul class="pl-5 mb-4 space-y-2 text-ink-2">
          <li><strong>Not brand video production</strong> &mdash; the goal is conversions, not polish or brand recall</li>
          <li><strong>Not random ad production</strong> &mdash; every creative tests a specific hypothesis with isolated variables</li>
          <li><strong>Not influencer marketing</strong> &mdash; creators produce content for ads, measured by CPA, not their audience reach</li>
          <li><strong>Not organic content</strong> &mdash; performance creative is specifically for paid media; <a href="/canvas-ugc" class="text-accent hover:underline">Canvas UGC</a> covers organic</li>
        </ul>
      </div>
    </section>

    <!-- 03 Performance vs Brand Creative -->
    <section class="guide-section" id="vs-brand">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">03 &mdash; Comparison</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Performance creative vs brand creative</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Brand creative: awareness, recall, consistency &mdash; measured in impressions and lift</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Performance creative: CPA, ROAS, revenue &mdash; measured in purchases</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Different goals, different production, different measurement</li>
          </ul>
        </div>

        <div class="overflow-x-auto rounded-xl border border-border bg-card mb-6">
          <table class="w-full border-collapse text-[14px]">
            <thead class="bg-bg">
              <tr>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Aspect</th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Brand Creative</th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Performance Creative</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Primary goal</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Awareness, recall, brand equity</td><td class="px-4 py-2.5 border-b border-border text-ink-2">CPA, ROAS, conversions</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Success metric</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Impressions, brand lift, sentiment</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Purchase data, revenue</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Production style</td><td class="px-4 py-2.5 border-b border-border text-ink-2">High polish, brand guidelines, agency</td><td class="px-4 py-2.5 border-b border-border text-ink-2">UGC-native, fast, modular</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Volume</td><td class="px-4 py-2.5 border-b border-border text-ink-2">2&ndash;5 hero ads per quarter</td><td class="px-4 py-2.5 border-b border-border text-ink-2">20&ndash;50+ new ads per month</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Decision maker</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Creative director, CMO</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Data &mdash; CPA below target = winner</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Timeline</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Weeks to months per campaign</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Days &mdash; produce, test, decide in a week</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Iteration</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Rare &mdash; campaigns run as planned</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Constant &mdash; iterate winners, kill losers</td></tr>
              <tr><td class="px-4 py-2.5 text-ink">Typical format</td><td class="px-4 py-2.5 text-ink-2">Polished video, studio shoots</td><td class="px-4 py-2.5 text-ink-2">UGC, talking head, screen recordings</td></tr>
            </tbody>
          </table>
        </div>

        <p class="text-ink-2 leading-[1.65] mb-4">Neither approach is universally right. Brand creative builds long-term equity. Performance creative drives immediate, measurable growth. Most brands at scale need both &mdash; but the production system, team, and measurement are completely different. Treating performance creative like brand creative (slow, polished, few variations) is the most common and most expensive mistake.</p>
      </div>
    </section>

    <!-- 04 The Performance Creative System -->
    <section class="guide-section" id="system">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">04 &mdash; System</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">The performance creative system</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Six stages: research &rarr; concept &rarr; production &rarr; test &rarr; analyze &rarr; iterate</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">The system is a loop, not a funnel &mdash; it never stops</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Each stage feeds the next with data and learnings</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">Performance creative is not a project with a start and end date. It is a continuous system. The six stages form a loop: analysis from the last round of tests informs research for the next round. Winners get iterated. Losers provide data on what to avoid. The system compounds learning over time.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">The six stages</h3>
        <ol class="list-none p-0 counter-reset-step space-y-0">
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Research.</strong> Analyze competitor ads (Meta Ad Library, TikTok Creative Center), review past test data, identify audience pain points and messaging gaps. Collect hooks that are working in the category.</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Concept.</strong> Develop 6&ndash;12 creative concepts per testing cycle. Each concept has a clear hypothesis: "This pain point will resonate with X audience." Write scripts with modular components &mdash; interchangeable hooks, bodies, and CTAs.</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Production.</strong> Shoot components, not finished ads. Hooks in one session, product demos in another, CTAs separately. UGC creators produce the majority of content. Modular production enables 72+ variations from 13 components.</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Test.</strong> Launch all variations simultaneously as ads. $50&ndash;$100/day per creative for 3&ndash;7 days. Follow the <a href="/guide" class="text-accent hover:underline">creative testing</a> framework: isolated variables, clear metrics, pre-set thresholds.</li>
          <li class="py-3.5 pl-[52px] relative border-b border-border text-ink-2 guide-step"><strong>Analyze.</strong> After reaching statistical significance (1,000+ impressions, 100+ clicks, 50+ conversions), tag every creative: Scale, Kill, or Iterate. Identify which components drive performance.</li>
          <li class="py-3.5 pl-[52px] relative text-ink-2 guide-step"><strong>Iterate.</strong> Scale winners (increase budget 20&ndash;30% every 3 days). Iterate near-misses (change one variable, retest). Kill losers. Feed learnings back into research for the next cycle.</li>
        </ol>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Why it must be a system</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">One-off creative production is a bet. A system is a portfolio of bets with compounding returns. Each cycle teaches the team what hooks, angles, formats, and creators work. Over time, the hit rate improves, the cost per winner drops, and the scaling speed increases. Brands that run performance creative as a system outperform those that produce ads in batches.</p>
      </div>
    </section>

    <!-- 05 Hook-First Production -->
    <section class="guide-section" id="hooks">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">05 &mdash; Hooks</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Hook-first production: 3 seconds decide everything</h2>
        <div class="tldr">
          <ul class="list-none p-0 m-0 space-y-1">
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Hook rate benchmark: 30&ndash;40% on Meta (3-second views &divide; impressions)</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">The hook is the single largest predictor of ad performance</li>
            <li class="text-[14px] text-ink-2 before:content-['—_'] before:text-accent before:font-semibold">Produce 5&ndash;10 hook variants per concept &mdash; test hooks before anything else</li>
          </ul>
        </div>
        <p class="text-ink-2 leading-[1.65] mb-4">In a feed-based environment, the first 3 seconds determine whether someone watches or scrolls. A strong hook can make an average script profitable. A weak hook kills even a brilliant concept. This is why performance creative production starts with hooks, not scripts.</p>
        <p class="text-ink-2 leading-[1.65] mb-4"><a href="/hook-rate" class="text-accent hover:underline">Hook rate</a> &mdash; the percentage of viewers who watch past 3 seconds &mdash; is the earliest creative health signal. On Meta in 2026, 30&ndash;40% is good, 35%+ is strong, and below 20% means the opening needs to be replaced. Hook rate predicts CPA before you've spent enough to measure CPA directly.</p>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">Hook types that work in performance creative</h3>
        <div class="overflow-x-auto rounded-xl border border-border bg-card mb-6">
          <table class="w-full border-collapse text-[14px]">
            <thead class="bg-bg">
              <tr>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Hook type</th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Example</th>
                <th class="font-display font-semibold text-[13px] px-4 py-3 text-left border-b border-border">Why it works</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Question hook</td><td class="px-4 py-2.5 border-b border-border text-ink-2">"Why is nobody talking about this?"</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Creates curiosity gap</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Stat hook</td><td class="px-4 py-2.5 border-b border-border text-ink-2">"I cut my ad costs by 47% with one change"</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Specific numbers create credibility</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Before/after hook</td><td class="px-4 py-2.5 border-b border-border text-ink-2">"My skin 6 months ago vs now"</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Visual contrast stops the scroll</td></tr>
              <tr><td class="px-4 py-2.5 border-b border-border text-ink">Controversy hook</td><td class="px-4 py-2.5 border-b border-border text-ink-2">"Your skincare routine is making it worse"</td><td class="px-4 py-2.5 border-b border-border text-ink-2">Challenges assumptions, triggers engagement</td></tr>
              <tr><td class="px-4 py-2.5 text-ink">"I tried X" hook</td><td class="px-4 py-2.5 text-ink-2">"I tried this AI tool for 30 days"</td><td class="px-4 py-2.5 text-ink-2">Personal experience creates trust</td></tr>
            </tbody>
          </table>
        </div>

        <h3 class="font-display font-semibold text-[20px] tracking-[-0.01em] mt-8 mb-3">How to test hooks</h3>
        <p class="text-ink-2 leading-[1.65] mb-4">Keep the body and CTA identical. Swap only the first 3 seconds. Run 5&ndash;10 hook variants with $50&ndash;$100/day each. After 3 days, compare hook rates and early CPA signals. Kill hooks below 20% hook rate. Iterate hooks in the 20&ndash;30% range. Scale hooks above 35%. This is the highest-leverage test in performance creative.</p>
      </div>
    </section>

    <!-- Mid CTA -->
    <section class="py-10">
      <div class="max-w-[800px] mx-auto px-6">
        <div class="bg-dark rounded-2xl p-10 md:p-14 text-center">
          <h2 class="font-display font-bold text-[clamp(22px,3.5vw,32px)] tracking-[-0.02em] text-white mb-3">Want OKAD to produce performance creative for your brand?</h2>
