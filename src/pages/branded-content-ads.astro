        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Key terms</h2>

        {[
          { term: "Branded Content Ad", def: "A paid advertisement that uses content created by a real person (creator/influencer) rather than brand-produced creative. The umbrella term for Spark Ads, Partnership Ads, and creator-powered YouTube ads." },
          { term: "Spark Ads", def: "TikTok's native branded content format. Brands boost existing organic creator posts as paid ads, retaining all engagement (likes, comments, shares). The most popular branded content ad format globally." },
          { term: "Partnership Ads", def: "Meta's branded content ad format (formerly Branded Content Ads). Creators tag the brand as a paid partner, and the brand promotes the tagged post through Ads Manager on Instagram and Facebook." },
          { term: "Whitelisting", def: "A delivery method where the creator grants the brand permission to run paid ads directly from the creator's social account. Maximizes authenticity but requires the most creator cooperation." },
          { term: "Whitelabel", def: "A delivery method where the creator delivers raw footage and the brand publishes/promotes the content from its own account. The creator's identity does not appear on the ad." },
          { term: "Paid Partnership Label", def: "The platform-generated disclosure that appears on branded content. Shows the audience that the content is a commercial collaboration. Required by both platform policy and advertising regulations." },
          { term: "FTC Disclosure", def: "The Federal Trade Commission's requirement that material connections between endorsers and brands be disclosed 'clearly and conspicuously' to the audience." },
          { term: "Creator Brief", def: "The document that outlines what a creator should produce: product story, key messages, hook suggestions, tone, format, do's and don'ts, and deliverable specifications." },
          { term: "Incrementality Testing", def: "A measurement methodology that isolates the true causal impact of an ad campaign by comparing conversion rates in exposed vs. unexposed groups (typically geographic holdouts)." },
          { term: "Brand Lift Study", def: "A controlled experiment that measures changes in brand awareness, recall, consideration, and purchase intent among audiences exposed to branded content vs. a control group." },
          { term: "Authorization Code", def: "A code generated by a TikTok creator that grants a brand permission to use their post as a Spark Ad. Codes can be set to expire after 30, 60, or 365 days." },
          { term: "BrandConnect", def: "YouTube's platform for matching brands with creators for sponsored content integrations. Provides campaign management, measurement, and creator discovery tools." },
          { term: "Creative Testing", def: "The systematic process of testing multiple ad creative variations to identify top performers before scaling spend. Branded content feeds this process with diverse creator perspectives." },
        ].map((item) => (
          <div class="py-4 border-b border-border">
            <div class="font-display font-semibold text-ink mb-1">{item.term}</div>
            <div class="text-[14px] text-muted">{item.def}</div>
          </div>
        ))}
