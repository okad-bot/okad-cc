      <div class="max-w-[800px] mx-auto px-6">
        <div class="font-mono text-[11px] font-medium uppercase tracking-[.1em] text-accent mb-2">10 &mdash; Glossary</div>
        <h2 class="font-display font-bold text-[clamp(24px,3.5vw,32px)] leading-[1.15] tracking-[-0.02em] text-ink mb-2">Key terms</h2>

        {[
          { term: "Hook rate", def: "The percentage of viewers who watch past the first 3 seconds of a video ad. Formula: 3-second video views / impressions x 100. Also called thumb-stop ratio." },
          { term: "Thumb-stop ratio", def: "Another name for hook rate. Refers to the moment a viewer stops scrolling (stops their thumb) to watch an ad." },
          { term: "Thumb-stop rate", def: "Synonym for hook rate and thumb-stop ratio. All three terms measure the same thing." },
          { term: "3-second video views", def: "The number of times a video ad was watched for at least 3 seconds. A standard metric in Meta Ads Manager." },
          { term: "Hook", def: "The first 3 seconds of a video ad. The opening that must capture attention before the viewer scrolls away." },
          { term: "Hold rate", def: "The percentage of viewers who watch past 15 seconds or 50% of the video. Measures the body's effectiveness, as opposed to the hook's." },
          { term: "Pattern interrupt", def: "A visual or audio element that breaks the expected pattern of the feed, forcing the viewer to stop scrolling and pay attention." },
          { term: "Text overlay", def: "Bold text placed on the first frames of a video ad to reinforce the verbal hook. Essential for Meta where many users scroll with sound off." },
          { term: "Hook test", def: "A structured test where 5-10 different hooks are attached to the same body and CTA, isolating the hook's impact on performance." },
          { term: "Creative fatigue", def: "The decline in ad performance as the audience sees it too often. Hook rate is one of the first metrics to decline during fatigue." },
          { term: "CPA", def: "Cost per acquisition. The decision metric in creative testing. Hook rate is the diagnostic; CPA is the judge." },
        ].map((item) => (
          <div class="py-4 border-b border-border">
            <div class="font-display font-semibold text-ink mb-1">{item.term}</div>
            <div class="text-[14px] text-muted">{item.def}</div>
          </div>
