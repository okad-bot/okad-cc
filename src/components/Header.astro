---
const navItems = [
  { text: "Work", href: "#work" },
  { text: "How it works", href: "#how" },
  { text: "What's inside", href: "#batch" },
  { text: "Results", href: "#results" },
  { text: "Process", href: "#process" },
  { text: "Pricing", href: "#pricing" },
  { text: "Blog", href: "/blog" },
  { text: "Contact", href: "#contact" },
];
---

<header id="site-header" class="fixed top-3 left-1/2 -translate-x-1/2 w-[calc(100%-48px)] max-w-[1080px] z-30 bg-white rounded-full shadow-[0_2px_16px_rgba(0,0,0,.1)]">
  <div class="flex items-center gap-3 md:gap-5 h-12 px-4 md:px-6">
    <a href="/" class="flex items-center gap-2 no-underline shrink-0">
      <img src="https://framerusercontent.com/images/9rU7XfzW4mHPYwiTjfyQcoLY.png" alt="OKAD" class="h-6" />
      <span class="font-display text-lg font-semibold tracking-tight text-ink">OKAD</span>
    </a>

    <nav class="flex items-center gap-3 md:gap-4 overflow-x-auto hide-scrollbar">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-[13px] font-medium text-ink/55 hover:text-ink transition-colors no-underline whitespace-nowrap"
        >
          {item.text}
        </a>
      ))}
      <a
        href="mailto:olga@okad.agency?subject=Creative%20testing%20%E2%80%94%20tell%20us%20about%20your%20product"
        class="ml-1 px-[18px] py-2 bg-ink text-white text-[13px] font-semibold rounded-full border border-ink hover:bg-[#333] hover:border-[#333] transition-colors no-underline whitespace-nowrap shrink-0"
      >
        Write to us →
      </a>
    </nav>
  </div>
</header>

<style>
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  @media (max-width: 768px) {
    #site-header {
      top: 0;
      border-radius: 0;
      width: 100%;
      box-shadow: 0 1px 8px rgba(0,0,0,.08);
    }
  }
</style>
