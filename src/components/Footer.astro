---
const productLinks = [
  { text: "Content Cases", href: "#content" },
  { text: "Design Cases", href: "#design" },
  { text: "Videos", href: "#video" },
  { text: "Contact", href: "#contact" },
];

const companyLinks = [
  { text: "OKAD Agency", href: "https://okad.agency" },
  { text: "ReelPilot", href: "https://reelpilot.co" },
  { text: "Contact", href: "mailto:olga@okad.agency" },
];
---

<footer class="pt-8 pb-5 border-t border-border text-[13px] text-muted">
  <div class="max-w-[1080px] mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-[1.5fr_1fr_1fr] gap-7 mb-5">
      <div>
        <div class="font-display text-lg font-semibold text-ink mb-2 flex items-center gap-1.5">
          <span class="text-accent">●</span> okad
        </div>
        <p class="text-[13px] text-muted leading-relaxed max-w-[240px]">
          Quality scroll-stopping content at scale. Ad creatives, UGC video, web design, and branding for global brands.
        </p>
      </div>

      <div>
        <h4 class="font-display text-[13px] font-semibold text-ink uppercase tracking-[.06em] mb-3">Portfolio</h4>
        <ul class="list-none p-0 m-0 space-y-2">
          {productLinks.map((link) => (
            <li>
              <a href={link.href} class="text-muted hover:text-accent transition-colors no-underline">{link.text}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-display text-[13px] font-semibold text-ink uppercase tracking-[.06em] mb-3">Company</h4>
        <ul class="list-none p-0 m-0 space-y-2">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="text-muted hover:text-accent transition-colors no-underline">{link.text}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-border pt-5 text-center text-xs text-muted-2">
      &copy; 2026 OKAD GROUP LLC. All rights reserved.
    </div>
  </div>
</footer>
